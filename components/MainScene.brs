            bg.color = "0x111827FF"

            label = g.createChild("Label")
            label.translation = [0, 10]
            label.width = width
            label.height = 22
            label.text = value
            label.color = "0xE2E8F0FF"
            label.font = "font:SmallBoldSystemFont"
            label.horizAlign = "center"

            rowNodes.push({bg:bg, label:label, value:value})
            x = x + width + 7
        end for
        m.keyboardNodes.push(rowNodes)
        y = y + 52
    end for
end sub

