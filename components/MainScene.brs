sub initProTimers()
    ' Temporizador de auto-ocultación del banner OSD del reproductor (8 segundos)
    m.osdBannerTimer = CreateObject("roSGNode", "Timer")
    m.osdBannerTimer.duration = 8.0
    m.osdBannerTimer.repeat = false
    m.osdBannerTimer.observeField("fire", "onOsdBannerTimerFired")

    ' Temporizador de Toast flotante
    m.toastTimer = CreateObject("roSGNode", "Timer")
    m.toastTimer.duration = 2.6
    m.toastTimer.repeat = false
    m.toastTimer.observeField("fire", "onToastTimerFired")

    ' Temporizador de Zapping numérico directo (0-9)
    m.numericZapTimer = CreateObject("roSGNode", "Timer")
    m.numericZapTimer.duration = 1.35
    m.numericZapTimer.repeat = false
    m.numericZapTimer.observeField("fire", "commitNumericZap")

    ' Temporizador de rotación del icono de sincronización
    m.syncSpinTimer = CreateObject("roSGNode", "Timer")
    m.syncSpinTimer.duration = 0.05
    m.syncSpinTimer.repeat = true
    m.syncSpinTimer.observeField("fire", "onSyncSpinStep")

    m.syncStopDelayTimer = CreateObject("roSGNode", "Timer")
    m.syncStopDelayTimer.duration = 0.9
    m.syncStopDelayTimer.repeat = false
    m.syncStopDelayTimer.observeField("fire", "onSyncStopDelayFired")

    ' Watchdog de auto-reconexión de canales en vivo
    m.watchdogStep1Timer = CreateObject("roSGNode", "Timer")
    m.watchdogStep1Timer.duration = 4.5
    m.watchdogStep1Timer.repeat = false
    m.watchdogStep1Timer.observeField("fire", "onWatchdogStep1")

    m.watchdogStep2Timer = CreateObject("roSGNode", "Timer")
    m.watchdogStep2Timer.duration = 9.0
    m.watchdogStep2Timer.repeat = false
    m.watchdogStep2Timer.observeField("fire", "onWatchdogStep2")
end sub
' --- RELOJ, FECHA Y SPLASH CON BARRA ANIMADA ---
sub startRealTimeClock()
    m.clockTimer = CreateObject("roSGNode", "Timer")
    m.clockTimer.duration = 60
    m.clockTimer.repeat = true
    m.clockTimer.observeField("fire", "updateRealTime")
    m.clockTimer.control = "start"
    updateRealTime()
end sub

sub updateRealTime()
    dt = CreateObject("roDateTime")
    if dt = invalid then return
    dt.ToLocalTime()

    h = dt.GetHours()
    mins = dt.GetMinutes()
    period = "am"
    if h >= 12 then period = "pm"
    h12 = h MOD 12
    if h12 = 0 then h12 = 12
    minStr = mins.toStr()
    if mins < 10 then minStr = "0" + minStr
    timeStr = h12.toStr() + ":" + minStr + " " + period

    wdText = weekdayLong(dt.GetWeekday())
    dayText = dt.GetDayOfMonth().toStr()
    monthText = monthShort(dt.GetMonth())
    yearText = dt.GetYear().toStr()

    if m.launcherClockLabel <> invalid then m.launcherClockLabel.text = timeStr
    if m.clockLabel <> invalid then m.clockLabel.text = timeStr
    if m.playerTimeLabel <> invalid then m.playerTimeLabel.text = timeStr
    if m.launcherDateLabel <> invalid then m.launcherDateLabel.text = wdText
    if m.launcherDate2Label <> invalid then m.launcherDate2Label.text = wdText + ", " + dayText + " " + monthText + " " + yearText
    if m.playerDateLabel <> invalid then m.playerDateLabel.text = yearText + " / " + dt.GetMonth().toStr() + " / " + dayText

    updateDayStrip()
end sub

sub updateDayStrip()
    nowDt = CreateObject("roDateTime")
    if nowDt = invalid then return
    baseSeconds = nowDt.AsSeconds()

    for i = 0 to 6
        dayDt = CreateObject("roDateTime")
        if dayDt <> invalid
            dayDt.FromSeconds(baseSeconds + (i * 86400))
            dayDt.ToLocalTime()
            shortName = weekdayShort(dayDt.GetWeekday())

            if i < m.days.count()
                m.days[i].num = dayDt.GetDayOfMonth().toStr()
                m.days[i].name = shortName
            end if
            if m.dayNodes <> invalid and i < m.dayNodes.count()
                node = m.dayNodes[i]
                if node.numLabel <> invalid then node.numLabel.text = dayDt.GetDayOfMonth().toStr()
                if node.nameLabel <> invalid then node.nameLabel.text = shortName
            end if
        end if
    end for
end sub

sub startSplashTimer()
    m.splashStep = 0
    m.splashBarTimer = CreateObject("roSGNode", "Timer")
    m.splashBarTimer.duration = 0.08
    m.splashBarTimer.repeat = true
    m.splashBarTimer.observeField("fire", "onSplashBarStep")
    m.splashBarTimer.control = "start"

    m.splashTimer = CreateObject("roSGNode", "Timer")
    m.splashTimer.duration = 1.8
    m.splashTimer.repeat = false
    m.splashTimer.observeField("fire", "onSplashFinished")
    m.splashTimer.control = "start"
end sub

sub onSplashBarStep()
    m.splashStep = m.splashStep + 1
    if m.splashProgressBar <> invalid
        w = 28 + (m.splashStep * 10)
        if w > 240 then w = 240
        m.splashProgressBar.width = w
    end if
end sub

sub onSplashFinished()
    if m.splashBarTimer <> invalid then m.splashBarTimer.control = "stop"
    if m.appState = "splash"
        m.appState = "launcher"
        updateAllUi()
        syncPlaylistsFromWeb(false)
    end if
end sub

' --- NOTIFICACIONES FLOTANTES, FAVORITOS, RECIENTES, ASPECT RATIO, RESOLUCIÓN Y ZAPPING NUMÉRICO ---
sub showToast(msg as String)
    if m.auraToastBox = invalid or m.auraToastLabel = invalid then return
    m.auraToastLabel.text = msg
    m.auraToastBox.visible = true
    if m.toastTimer <> invalid
        m.toastTimer.control = "stop"
        m.toastTimer.control = "start"
    end if
end sub

sub onToastTimerFired()
    if m.auraToastBox <> invalid then m.auraToastBox.visible = false
end sub

function isChannelFavorite(url as String) as Boolean
    if url = "" or m.favoriteUrls = invalid then return false
    for each u in m.favoriteUrls
        if u = url then return true
    end for
    return false
end function

sub toggleFavoriteChannel(ch as Object)
    if ch = invalid or not ch.DoesExist("url") or ch.url = "" then return
    url = ch.url
    newFavs = []
    found = false
    for each u in m.favoriteUrls
        if u = url
            found = true
        else
            newFavs.push(u)
        end if
    end for

    if found
        m.favoriteUrls = newFavs
        showToast("Quitado de Favoritos: " + ch.name)
    else
        reordered = [url]
        for each u in newFavs
            reordered.push(u)
        end for
        m.favoriteUrls = reordered
        showToast("* Agregado a Favoritos: " + ch.name)
    end if

    savePrefs()
    updateCategoryCountsLabels()
    updateChannelStatsUi()
    if m.appState = "regional" then updateRegionalUi()
    if m.appState = "player"
        updatePlayerUi()
        showPlayerOsdBanner()
        if m.miniGuideOpen then updateMiniGuideUi()
    end if
end sub

sub recordRecentChannel(ch as Object)
    if ch = invalid or not ch.DoesExist("url") or ch.url = "" then return
    if m.currentPreviewChannel <> invalid and m.currentPreviewChannel.DoesExist("url") and m.currentPreviewChannel.url <> "" and m.currentPreviewChannel.url <> ch.url
        m.previousChannel = m.currentPreviewChannel
    end if

    m.lastWatchedUrl = ch.url
    if ch.DoesExist("name") and ch.name <> invalid
        m.lastWatchedName = ch.name
    else
        m.lastWatchedName = ""
    end if

    reordered = [ch.url]
    for each u in m.recentUrls
        if u <> ch.url and reordered.count() < 20
            reordered.push(u)
        end if
    end for
    m.recentUrls = reordered
    savePrefs()
    updateCategoryCountsLabels()
    updateChannelStatsUi()
end sub

function formatResolutionBadge(w as Integer, h as Integer) as String
    if h >= 2000 or w >= 3600 then return "4K UHD"
    if h >= 1000 or w >= 1800 then return "1080p FHD"
    if h >= 700 or w >= 1200 then return "720p HD"
    if h >= 460 then return "SD " + h.toStr() + "p"
    if h > 0 then return w.toStr() + "x" + h.toStr()
    return "LIVE"
end function

sub onVideoStreamInfo()
    if m.videoPlayer = invalid then return
    info = m.videoPlayer.streamInfo
    if info <> invalid
        w = 0
        h = 0
        if info.DoesExist("videoWidth") and info.videoWidth <> invalid then w = info.videoWidth
        if info.DoesExist("videoHeight") and info.videoHeight <> invalid then h = info.videoHeight
        if h > 0 or w > 0
            m.videoResolutionLabel = formatResolutionBadge(w, h)
            if m.playerResBadge <> invalid then m.playerResBadge.text = m.videoResolutionLabel
        end if
    end if
end sub

sub cycleAspectRatio()
    if m.aspectMode = "fill"
        m.aspectMode = "fit"
    else if m.aspectMode = "fit"
        m.aspectMode = "zoom"
    else
        m.aspectMode = "fill"
    end if

    applyAspectRatioToVideo()

    labelTxt = "16:9"
    if m.aspectMode = "fit" then labelTxt = "ORIGINAL"
    if m.aspectMode = "zoom" then labelTxt = "ZOOM"
    if m.playerAspectBadge <> invalid then m.playerAspectBadge.text = labelTxt
    showToast("Formato de pantalla: " + labelTxt)
    showPlayerOsdBanner()
end sub

sub applyAspectRatioToVideo()
    if m.videoPlayer = invalid or m.appState <> "player" then return
    if m.aspectMode = "fit"
        m.videoPlayer.translation = [80, 0]
        m.videoPlayer.width = 1120
        m.videoPlayer.height = 720
    else if m.aspectMode = "zoom"
        m.videoPlayer.translation = [-64, -36]
        m.videoPlayer.width = 1408
        m.videoPlayer.height = 792
    else
        m.videoPlayer.translation = [0, 0]
        m.videoPlayer.width = 1280
        m.videoPlayer.height = 720
    end if
end sub

function getActivePlayerChannelList() as Object
    if m.currentCategoryChannels <> invalid and m.currentCategoryChannels.count() > 0
        list = []
        for each item in m.currentCategoryChannels
            if item <> invalid and item.DoesExist("channelData") and item.channelData <> invalid
                list.push(item.channelData)
            end if
        end for
        if list.count() > 0 then return list
    end if
    return m.channels
end function

sub buildMiniGuide()
    if m.miniGuideRowsGroup = invalid then return
    m.miniGuideNodes = []
    for i = 0 to 10
        row = m.miniGuideRowsGroup.createChild("Group")
        row.translation = [0, i * 50]
        row.visible = false

        border = row.createChild("Rectangle")
        border.width = 376
        border.height = 44
        border.color = "0xFFFFFF18"

        bg = row.createChild("Rectangle")
        bg.translation = [1, 1]
        bg.width = 374
        bg.height = 42
        bg.color = "0x0F1624D8"

        numBg = row.createChild("Rectangle")
        numBg.translation = [10, 9]
        numBg.width = 44
        numBg.height = 26
        numBg.color = "0xFFFFFF16"

        num = row.createChild("Label")
        num.translation = [10, 11]
        num.width = 44
        num.height = 22
        num.horizAlign = "center"
        num.color = "0x38BDF8FF"
        num.font = "font:SmallestSystemFont"

        logo = row.createChild("Poster")
        logo.translation = [62, 6]
        logo.width = 32
        logo.height = 32
        logo.loadDisplayMode = "scaleToFit"
        logo.visible = false

        name = row.createChild("Label")
        name.translation = [102, 10]
        name.width = 260
        name.height = 24
        name.color = "0xF8FAFCFF"
        name.font = "font:SmallBoldSystemFont"

        m.miniGuideNodes.push({row:row, border:border, bg:bg, numBg:numBg, num:num, logo:logo, name:name})
    end for
end sub

sub openMiniGuide()
    list = getActivePlayerChannelList()
    if list = invalid or list.count() = 0 then return
    m.miniGuideOpen = true
    curIdx = 0
    if m.currentPreviewChannel <> invalid
        for i = 0 to list.count() - 1
            if list[i].url = m.currentPreviewChannel.url
                curIdx = i
                exit for
            end if
        end for
    end if
    m.miniGuideIndex = curIdx
    if m.miniGuideIndex < m.miniGuideTop then m.miniGuideTop = m.miniGuideIndex
    if m.miniGuideIndex > m.miniGuideTop + 10 then m.miniGuideTop = m.miniGuideIndex - 10
    if m.playerMiniGuide <> invalid then m.playerMiniGuide.visible = true
    updateMiniGuideUi()
end sub

sub closeMiniGuide()
    m.miniGuideOpen = false
    if m.playerMiniGuide <> invalid then m.playerMiniGuide.visible = false
end sub

sub updateMiniGuideUi()
    if not m.miniGuideOpen then return
    list = getActivePlayerChannelList()
    if list = invalid then return

    if m.miniGuideIndex < m.miniGuideTop then m.miniGuideTop = m.miniGuideIndex
    if m.miniGuideIndex > m.miniGuideTop + 10 then m.miniGuideTop = m.miniGuideIndex - 10
    if m.miniGuideTop < 0 then m.miniGuideTop = 0

    for i = 0 to m.miniGuideNodes.count() - 1
        node = m.miniGuideNodes[i]
        idx = m.miniGuideTop + i
        if idx < list.count()
            ch = list[idx]
            node.row.visible = true
            node.num.text = ch.num.toStr()

            hasLogo = (ch.DoesExist("logo") and ch.logo <> invalid and ch.logo <> "")
            if hasLogo
                node.logo.uri = ch.logo
                node.logo.visible = true
                node.name.translation = [102, 10]
                node.name.width = 260
            else
                node.logo.visible = false
                node.name.translation = [64, 10]
                node.name.width = 298
            end if

            favPrefix = ""
            if isChannelFavorite(ch.url) then favPrefix = "* "
            isPlayingNow = (m.currentPreviewChannel <> invalid and m.currentPreviewChannel.url = ch.url)
            liveSuffix = ""
            if isPlayingNow then liveSuffix = "  • EN VIVO"
            node.name.text = favPrefix + ch.name + liveSuffix

            if idx = m.miniGuideIndex
                node.border.color = "0x38BDF8FF"
                node.bg.color = "0xFFFFFFFF"
                node.numBg.color = "0x090D16FF"
                node.num.color = "0x38BDF8FF"
                node.name.color = "0x090D16FF"
            else if isPlayingNow
                node.border.color = "0x38BDF877"
                node.bg.color = "0x1D4ED855"
                node.numBg.color = "0xFFFFFF18"
                node.num.color = "0x38BDF8FF"
                node.name.color = "0xF8FAFCFF"
            else
                node.border.color = "0xFFFFFF18"
                node.bg.color = "0x0F1624D8"
                node.numBg.color = "0xFFFFFF16"
                node.num.color = "0x38BDF8FF"
                node.name.color = "0xF8FAFCFF"
            end if
        else
            node.row.visible = false
        end if
    end for
end sub

function extractDigitFromKey(key as String) as String
    if Len(key) = 1 and key >= "0" and key <= "9" then return key
    if Left(key, 4) = "Lit_" and Len(key) = 5
        d = Right(key, 1)
        if d >= "0" and d <= "9" then return d
    end if
    if Left(key, 4) = "num_" and Len(key) = 5
        d = Right(key, 1)
        if d >= "0" and d <= "9" then return d
    end if
    return ""
end function

function handleNumberKey(digit as String) as Boolean
    if m.entryOpen or m.appState = "search" or m.appState = "addPlaylist" then return false
    if m.channels = invalid or m.channels.count() = 0 then return false
    if Len(m.numericBuffer) >= 4 then m.numericBuffer = ""
    m.numericBuffer = m.numericBuffer + digit

    numVal = m.numericBuffer.ToInt()
    matchCh = invalid
    for each ch in m.channels
        if ch.num = numVal
            matchCh = ch
            exit for
        end if
    end for
    if matchCh = invalid and numVal >= 1 and numVal <= m.channels.count()
        matchCh = m.channels[numVal - 1]
    end if

    if m.numericZapNumber <> invalid then m.numericZapNumber.text = m.numericBuffer
    if m.numericZapName <> invalid
        if matchCh <> invalid
            m.numericZapName.text = matchCh.name
        else
            m.numericZapName.text = "Canal no encontrado"
        end if
    end if
    if m.numericZapBox <> invalid then m.numericZapBox.visible = true

    if m.numericZapTimer <> invalid
        m.numericZapTimer.control = "stop"
        m.numericZapTimer.control = "start"
    end if
    return true
end function

sub commitNumericZap()
    if m.numericZapTimer <> invalid then m.numericZapTimer.control = "stop"
    buf = m.numericBuffer
    m.numericBuffer = ""
    if m.numericZapBox <> invalid then m.numericZapBox.visible = false
    if buf = "" or m.channels.count() = 0 then return

    numVal = buf.ToInt()
    if numVal <= 0 then return

    targetCh = invalid
    for each ch in m.channels
        if ch.num = numVal
            targetCh = ch
            exit for
        end if
    end for
    if targetCh = invalid and numVal >= 1 and numVal <= m.channels.count()
        targetCh = m.channels[numVal - 1]
    end if

    if targetCh = invalid
        showToast("Canal #" + numVal.toStr() + " no encontrado")
        return
    end if

    if m.appState = "player"
        playChannelInFullscreenDirect(targetCh)
    else
        openPlayerPreview(targetCh)
        openPlayerFull()
    end if
end sub

' --- AUTO-RECONEXIÓN, SALUD DE CANALES Y BANNER OSD (8 SEGUNDOS) ---
sub showPlayerOsdBanner()
    if m.playerBannerBox <> invalid then m.playerBannerBox.visible = true
    if m.osdBannerTimer <> invalid
        m.osdBannerTimer.control = "stop"
        m.osdBannerTimer.control = "start"
    end if
end sub

sub onOsdBannerTimerFired()
    if m.appState = "player" and m.playerBannerBox <> invalid
        m.playerBannerBox.visible = false
    end if
end sub

sub clearPlaybackWatchdog()
    if m.watchdogStep1Timer <> invalid then m.watchdogStep1Timer.control = "stop"
    if m.watchdogStep2Timer <> invalid then m.watchdogStep2Timer.control = "stop"
end sub

sub startPlaybackWatchdog()
    clearPlaybackWatchdog()
    if m.watchdogStep1Timer <> invalid then m.watchdogStep1Timer.control = "start"
    if m.watchdogStep2Timer <> invalid then m.watchdogStep2Timer.control = "start"
end sub

sub onWatchdogStep1()
    if m.currentPreviewChannel = invalid then return
    if m.currentPlayerStatus = "playing" or m.currentPlayerStatus = "unavailable" then return
    attemptReconnectStream()
end sub

sub onWatchdogStep2()
    if m.currentPreviewChannel = invalid then return
    if m.currentPlayerStatus = "playing" then return
    setPlayerChannelStatus("unavailable", m.currentPreviewChannel.url, "Sin señal de video")
end sub

sub onVideoPlayerStateChange()
    if m.videoPlayer = invalid or m.currentPreviewChannel = invalid then return
    st = m.videoPlayer.state
    curUrl = m.currentPreviewChannel.url

    if st = "playing"
        m.reconnectAttempts = 0
        clearPlaybackWatchdog()
        setPlayerChannelStatus("playing", curUrl, "")
        onVideoStreamInfo()
    else if st = "buffering"
        startPlaybackWatchdog()
    else if st = "error" or st = "finished"
        if m.reconnectAttempts < 2
            attemptReconnectStream()
        else
            setPlayerChannelStatus("unavailable", curUrl, "Sin señal")
        end if
    end if
end sub

sub attemptReconnectStream()
    if m.currentPreviewChannel = invalid or m.videoPlayer = invalid then return
    m.reconnectAttempts = m.reconnectAttempts + 1
    curUrl = m.currentPreviewChannel.url
    attemptLabel = m.reconnectAttempts.toStr() + "/2"
    setPlayerChannelStatus("reconnecting", curUrl, attemptLabel)

    retryUrl = curUrl
    if m.reconnectAttempts = 2 and Instr(1, LCase(curUrl), ".ts") > 0 and Instr(1, LCase(curUrl), "/live/") > 0
        retryUrl = Left(curUrl, Len(curUrl) - 3) + ".m3u8"
    end if

    videoContent = CreateObject("roSGNode", "ContentNode")
    videoContent.url = retryUrl
    videoContent.title = m.currentPreviewChannel.name
    videoContent.streamFormat = getStreamFormat(retryUrl)
    m.videoPlayer.content = videoContent
    m.videoPlayer.control = "play"
    startPlaybackWatchdog()
end sub

sub setPlayerChannelStatus(status as String, url as String, detail as String)
    if url = "" or (m.currentPreviewChannel <> invalid and m.currentPreviewChannel.url <> url) then return
    m.currentPlayerStatus = status
    m.currentPlayerDetail = detail

    if status = "playing"
        m.channelStatusMap[url] = "online"
        updateChannelStatsUi()
        if m.appState = "regional" then updateRegionalUi()
    else if status = "unavailable"
        m.channelStatusMap[url] = "offline"
        updateChannelStatsUi()
        if m.appState = "regional" then updateRegionalUi()
    end if

    updateStreamStatusOverlays()
end sub

sub updateStreamStatusOverlays()
    st = m.currentPlayerStatus
    if m.currentPreviewChannel = invalid or st = "playing" or st = "idle"
        if m.previewStatusOverlay <> invalid then m.previewStatusOverlay.visible = false
        if m.playerStreamStatusBadge <> invalid then m.playerStreamStatusBadge.visible = false
        return
    end if

    if st = "reconnecting"
        attemptTxt = ""
        if m.currentPlayerDetail <> "" then attemptTxt = " (" + m.currentPlayerDetail + ")"
        if m.previewStatusIcon <> invalid then m.previewStatusIcon.text = "R"
        if m.previewStatusOverlay <> invalid
            m.previewStatusOverlay.visible = (m.appState = "regional")
            if m.previewStatusTitle <> invalid then m.previewStatusTitle.text = "Reconectando señal" + attemptTxt + "..."
            if m.previewStatusSubtitle <> invalid then m.previewStatusSubtitle.text = m.currentPreviewChannel.name
        end if
        if m.playerStreamStatusBadge <> invalid
            m.playerStreamStatusBadge.visible = (m.appState = "player")
            if m.playerStreamStatusTitle <> invalid then m.playerStreamStatusTitle.text = "Reconectando señal automáticamente" + attemptTxt + "..."
            if m.playerStreamStatusSub <> invalid then m.playerStreamStatusSub.text = "Restableciendo transmisión sin salir del canal"
        end if
    else if st = "unavailable"
        if m.previewStatusIcon <> invalid then m.previewStatusIcon.text = "!"
        if m.previewStatusOverlay <> invalid
            m.previewStatusOverlay.visible = (m.appState = "regional")
            if m.previewStatusTitle <> invalid then m.previewStatusTitle.text = "Canal no disponible en el momento"
            if m.previewStatusSubtitle <> invalid then m.previewStatusSubtitle.text = "Presiona OK para reintentar o selecciona otro canal"
        end if
        if m.playerStreamStatusBadge <> invalid
            m.playerStreamStatusBadge.visible = (m.appState = "player")
            if m.playerStreamStatusTitle <> invalid then m.playerStreamStatusTitle.text = "Canal no disponible en el momento"
            if m.playerStreamStatusSub <> invalid then m.playerStreamStatusSub.text = "Presiona OK para reintentar o Arriba/Abajo para cambiar de canal"
            if m.appState = "player" then showPlayerOsdBanner()
        end if
    else
        if m.previewStatusOverlay <> invalid then m.previewStatusOverlay.visible = false
        if m.playerStreamStatusBadge <> invalid then m.playerStreamStatusBadge.visible = false
    end if
end sub

sub updateChannelStatsUi()
    total = m.channels.count()
    offlineCount = 0
    for i = 0 to total - 1
        chUrl = m.channels[i].url
        if m.channelStatusMap.DoesExist(chUrl) and m.channelStatusMap[chUrl] = "offline"
            offlineCount = offlineCount + 1
        end if
    end for
    activeCount = total - offlineCount
    if activeCount < 0 then activeCount = 0

    catCount = 0
    for each c in m.categories
        if c <> invalid and c.type = "category" then catCount = catCount + 1
    end for

    if total = 0
        msg = "Sin canales cargados · Vincula tu lista en auratv.site.je"
        if m.playlists.count() > 0 then msg = "Cargando canales de tu lista..."
        if m.launcherChannelStatsLabel <> invalid then m.launcherChannelStatsLabel.text = msg
        if m.regionalChannelStatsLabel <> invalid then m.regionalChannelStatsLabel.text = msg
    else
        favTxtL = ""
        favTxtR = ""
        if m.favoriteUrls.count() > 0
            favTxtL = "   ·   * Favoritos: " + m.favoriteUrls.count().toStr()
            favTxtR = "  ·  * Fav: " + m.favoriteUrls.count().toStr()
        end if
        offTxtL = ""
        offTxtR = ""
        if offlineCount > 0
            offTxtL = "   ·   Caídos: " + offlineCount.toStr()
            offTxtR = "  ·  Caídos: " + offlineCount.toStr()
        end if
        lastTxt = ""
        if m.lastWatchedName <> "" then lastTxt = "   ·   Último: " + m.lastWatchedName

        summaryLauncher = "Canales activos: " + activeCount.toStr() + " / " + total.toStr() + " total   ·   Categorías: " + catCount.toStr() + favTxtL + offTxtL + lastTxt
        summaryRegional = "Activos: " + activeCount.toStr() + " / Total: " + total.toStr() + "  ·  Categorías: " + catCount.toStr() + favTxtR + offTxtR
        if m.launcherChannelStatsLabel <> invalid then m.launcherChannelStatsLabel.text = summaryLauncher
        if m.regionalChannelStatsLabel <> invalid then m.regionalChannelStatsLabel.text = summaryRegional
    end if

    if m.launcherTileNodes <> invalid and m.launcherTileNodes.count() >= 2
        if m.launcherTileNodes[0].subLabel <> invalid
            if total > 0
                m.launcherTileNodes[0].subLabel.text = "+" + activeCount.toStr() + " Canales"
            else
                m.launcherTileNodes[0].subLabel.text = "0 Canales"
            end if
        end if
        if m.launcherTileNodes[1].subLabel <> invalid
            if m.addonItems <> invalid and m.addonItems.count() > 0
                m.launcherTileNodes[1].subLabel.text = m.addonItems.count().toStr() + " Add-ons"
            else
                m.launcherTileNodes[1].subLabel.text = "Catálogos VOD"
            end if
        end if
    end if
end sub

' --- ANIMACIÓN DE GIRO DEL ICONO DE SINCRONIZACIÓN ---
sub startSyncWheelAnimation()
    if m.syncStopDelayTimer <> invalid then m.syncStopDelayTimer.control = "stop"
    if m.syncSpinTimer <> invalid then m.syncSpinTimer.control = "start"
end sub

sub stopSyncWheelAnimation()
    if m.syncStopDelayTimer <> invalid
        m.syncStopDelayTimer.control = "stop"
        m.syncStopDelayTimer.control = "start"
    end if
end sub

sub onSyncStopDelayFired()
    if not m.syncInFlight and not m.channelLoadInFlight
        if m.syncSpinTimer <> invalid then m.syncSpinTimer.control = "stop"
        m.syncSpinAngle = 0.0
        if m.launcherSyncIcon <> invalid then m.launcherSyncIcon.rotation = 0.0
        if m.playlistRefreshIcon <> invalid then m.playlistRefreshIcon.rotation = 0.0
    end if
end sub

sub onSyncSpinStep()
    m.syncSpinAngle = m.syncSpinAngle - 0.38
    if m.syncSpinAngle < -6.283185 then m.syncSpinAngle = m.syncSpinAngle + 6.283185
    if m.launcherSyncIcon <> invalid then m.launcherSyncIcon.rotation = m.syncSpinAngle
    if m.playlistRefreshIcon <> invalid then m.playlistRefreshIcon.rotation = m.syncSpinAngle
end sub
function currentLanguageLabel() as String
    if m.language = "en" then return "English"
    if m.language = "zh" then return "Chinese"
    return "Español"
end function

