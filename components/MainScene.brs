            width = getKeyWidth(value)
            g = m.searchKeyboardGroup.createChild("Group")
            g.translation = [x, y]

            border = g.createChild("Rectangle")
            border.width = width
            border.height = 44
            border.color = "0xFFFFFF14"

            bg = g.createChild("Rectangle")
            bg.translation = [1, 1]
