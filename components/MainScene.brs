        y = y + 48
    end for
end sub

function getDeviceMac() as String
    device = CreateObject("roDeviceInfo")
    if device = invalid then return "00:00:00:00:00:00"

    clientId = device.GetChannelClientId()
    if clientId = invalid or clientId = "" then return "00:00:00:00:00:00"

    raw = UCase(clientId)
    cleanRaw = ""

    for i = 1 to Len(raw)
        c = Mid(raw, i, 1)
        if (c >= "0" and c <= "9") or (c >= "A" and c <= "F") then
            cleanRaw = cleanRaw + c
        end if
    end for

    if Len(cleanRaw) >= 12
        return Mid(cleanRaw, 1, 2) + ":" + Mid(cleanRaw, 3, 2) + ":" + Mid(cleanRaw, 5, 2) + ":" + Mid(cleanRaw, 7, 2) + ":" + Mid(cleanRaw, 9, 2) + ":" + Mid(cleanRaw, 11, 2)
    end if

    return "00:00:00:00:00:00"
end function

function getOrCreateDeviceKey() as String
    sec = CreateObject("roRegistrySection", "AuraTV")
    if sec <> invalid
        stored = sec.Read("deviceKey")
        if stored <> invalid and Len(stored) = 6 then return stored
    end if

    dt = CreateObject("roDateTime")
    seed = 123456
    if dt <> invalid then seed = dt.AsSeconds() MOD 900000
    seed = seed + 100000
    keyStr = seed.toStr()
    if Len(keyStr) > 6 then keyStr = Mid(keyStr, Len(keyStr) - 5, 6)

    if sec <> invalid
        sec.Write("deviceKey", keyStr)
        sec.Flush()
    end if
    return keyStr
end function

sub refreshSearchResults()
    results = []
    q = LCase(m.searchQuery.Trim())
    for each ch in m.channels
        if q = ""
            results.push(ch)
        else
            nameMatch = (Instr(1, LCase(ch.name), q) > 0)
            numMatch = (Instr(1, ch.num.toStr(), q) > 0)
            catMatch = false
            if ch.DoesExist("category") and ch.category <> invalid
                catMatch = (Instr(1, LCase(ch.category), q) > 0)
            end if
            if nameMatch or numMatch or catMatch then results.push(ch)
        end if
    end for
    m.filteredChannels = results
    if m.filteredChannels.count() = 0
        m.channelIndex = -1
        m.channelTop = 0
    else
        if m.channelIndex < 0 then m.channelIndex = 0
        if m.channelIndex >= m.filteredChannels.count() then m.channelIndex = m.filteredChannels.count() - 1
        adjustChannelWindow()
    end if
    refreshSearchChannelRows()
end sub

sub adjustChannelWindow()
    if m.channelIndex < 0 then return
    if m.channelIndex < m.channelTop then m.channelTop = m.channelIndex
    lastVisible = m.channelTop + m.visibleChannelRows - 1
    if m.channelIndex > lastVisible then m.channelTop = m.channelIndex - m.visibleChannelRows + 1
    if m.channelTop < 0 then m.channelTop = 0
end sub

sub refreshSearchChannelRows()
    for i = 0 to m.visibleChannelRows - 1
        if i < m.searchChannelRowNodes.count()
            node = m.searchChannelRowNodes[i]
            dataIndex = m.channelTop + i
            if dataIndex < m.filteredChannels.count()
                item = m.filteredChannels[dataIndex]
                if node.row <> invalid then node.row.visible = true
                if node.numLabel <> invalid then node.numLabel.text = item.num.toStr()
                if node.nameLabel <> invalid then node.nameLabel.text = item.name
                if node.logoLabel <> invalid then node.logoLabel.text = "•"
            else
                if node.row <> invalid then node.row.visible = false
            end if
        end if
    end for
end sub

sub refreshPlaylistRows()
    for i = 0 to m.playlistRowNodes.count() - 1
        if i < m.playlistRowNodes.count()
            node = m.playlistRowNodes[i]
            if i < m.playlists.count()
                if node.row <> invalid then node.row.visible = true
                if node.num <> invalid then node.num.text = (i + 1).toStr()
                if node.name <> invalid then node.name.text = m.playlists[i].name
            else
                if node.row <> invalid then node.row.visible = false
            end if
        end if
    end for
end sub

sub refreshAddPlaylistFieldText()
    vals = [m.addHost, m.addUsername, m.addPassword]
    for i = 0 to m.addPlaylistFieldNodes.count() - 1
        if i < m.addPlaylistFieldNodes.count()
            node = m.addPlaylistFieldNodes[i]
            val = vals[i]
            if val = ""
                if node.label <> invalid then node.label.text = auraText(node.placeholderKey)
            else if i = 2
                masked = ""
                for j = 1 to Len(val)
                    masked = masked + "*"
                end for
                if node.label <> invalid then node.label.text = masked
            else
                if node.label <> invalid then node.label.text = val
            end if
        end if
    end for
end sub
' --- ACTUALIZACIÓN DE VISTAS Y ESTADOS ---
sub updateAllUi()
    applyLanguageUi()

    if m.splashGroup <> invalid then m.splashGroup.visible = (m.appState = "splash")
    if m.launcherGroup <> invalid then m.launcherGroup.visible = (m.appState = "launcher")
    if m.regionalGroup <> invalid then m.regionalGroup.visible = (m.appState = "regional")
    if m.searchGroup <> invalid then m.searchGroup.visible = (m.appState = "search")
    if m.moviesGroup <> invalid then m.moviesGroup.visible = (m.appState = "movies")
    if m.addonsGroup <> invalid then m.addonsGroup.visible = (m.appState = "addons")

    if m.playerGroup <> invalid
        m.playerGroup.visible = (m.appState = "player")
    end if

    if m.playlistsGroup <> invalid then m.playlistsGroup.visible = (m.appState = "playlists")
    if m.addPlaylistGroup <> invalid then m.addPlaylistGroup.visible = (m.appState = "addPlaylist")
    if m.settingsGroup <> invalid then m.settingsGroup.visible = (m.appState = "settings")
    if m.entryOverlayGroup <> invalid then m.entryOverlayGroup.visible = m.entryOpen
    if m.soonGroup <> invalid then m.soonGroup.visible = m.modalOpen

    updateChannelStatsUi()
    updateLauncherUi()
    updateRegionalUi()
    updateSearchUi()
    updatePlayerUi()
    updatePlaylistsUi()
    updateAddPlaylistUi()
    updateSettingsUi()
    updateMoviesUi()
    updateAddonsUi()
    updateEntryUi()
    updateStreamStatusOverlays()
end sub

sub updateLauncherUi()
    if m.appState <> "launcher" then return
    for i = 0 to m.launcherTileNodes.count() - 1
        node = m.launcherTileNodes[i]
        if node <> invalid
            if i = m.launcherTileIndex
                if node.group <> invalid then node.group.translation = [node.baseX, node.baseY - 6]
                if node.layout = "main"
                    if node.focusBorder <> invalid then node.focusBorder.color = "0xFACC15FF"
                    if node.bg <> invalid then node.bg.color = "0x26444EFF"
                    if node.topGlow <> invalid then node.topGlow.color = "0xFACC1566"
                    if node.topGlow <> invalid then node.topGlow.opacity = 0.85
                    if node.topBar <> invalid then node.topBar.opacity = 1.0
                else
                    if node.focusBorder <> invalid then node.focusBorder.color = "0xFACC15DD"
                    if node.bg <> invalid then node.bg.color = "0x243F4BFF"
                    if node.label <> invalid then node.label.color = "0xFFFFFFFF"
                end if
            else
                if node.group <> invalid then node.group.translation = [node.baseX, node.baseY]
                if node.layout = "main"
                    if node.focusBorder <> invalid then node.focusBorder.color = "0xFFFFFF22"
                    if node.bg <> invalid then node.bg.color = "0x1A242BFF"
                    if node.topGlow <> invalid then node.topGlow.color = "0x2C4E5A55"
                    if node.topGlow <> invalid then node.topGlow.opacity = 0.35
                    if node.topBar <> invalid then node.topBar.opacity = 0.0
                else
                    if node.focusBorder <> invalid then node.focusBorder.color = "0xFFFFFF1C"
                    if node.bg <> invalid then node.bg.color = "0x111820FF"
                    if node.label <> invalid then node.label.color = "0xE2E8F0FF"
                end if
            end if
        end if
    end for
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub updateRegionalUi()
    if m.appState <> "regional" then return

    refreshLeftNavRows()

    for i = 0 to 12
        if i < m.leftNavNodes.count()
            node = m.leftNavNodes[i]
            dataIndex = m.leftNavTop + i
            if node.row <> invalid and node.row.visible = true and dataIndex < m.leftNavItems.count()
                if m.homeFocus = "left" and dataIndex = m.leftIndex
                    if node.border <> invalid then node.border.color = "0x38BDF8FF"
                    if node.bg <> invalid then node.bg.color = "0xFFFFFFFF"
                    if node.label <> invalid then node.label.color = "0x090D16FF"
                else
                    if node.border <> invalid then node.border.color = "0xFFFFFF14"
                    if node.bg <> invalid then node.bg.color = "0x0D131FFF"
                    if node.label <> invalid then node.label.color = "0xE2E8F0FF"
                end if
            end if
        end if
    end for

    for i = 0 to m.dayNodes.count() - 1
        if i < m.dayNodes.count()
            node = m.dayNodes[i]
            if i = m.dayIndex
                if m.homeFocus = "days"
                    if node.border <> invalid then node.border.color = "0x38BDF8FF"
                    if node.bg <> invalid then node.bg.color = "0xFFFFFFFF"
                    if node.numLabel <> invalid then node.numLabel.color = "0x090D16FF"
                    if node.nameLabel <> invalid then node.nameLabel.color = "0x334155FF"
                else
                    if node.border <> invalid then node.border.color = "0x38BDF888"
                    if node.bg <> invalid then node.bg.color = "0x1D4ED8FF"
                    if node.numLabel <> invalid then node.numLabel.color = "0xFFFFFFFF"
                    if node.nameLabel <> invalid then node.nameLabel.color = "0xCBD5E1FF"
                end if
            else
                if node.border <> invalid then node.border.color = "0xFFFFFF14"
                if node.bg <> invalid then node.bg.color = "0x0D131FFF"
                if node.numLabel <> invalid then node.numLabel.color = "0xFFFFFFFF"
                if node.nameLabel <> invalid then node.nameLabel.color = "0x64748BFF"
            end if
        end if
    end for
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub updateSearchUi()
    if m.appState <> "search" then return
    if m.searchQueryLabel <> invalid then m.searchQueryLabel.text = m.searchQuery
    for i = 0 to m.visibleChannelRows - 1
        if i < m.searchChannelRowNodes.count()
            node = m.searchChannelRowNodes[i]
            dataIndex = m.channelTop + i
            if node.row <> invalid and node.row.visible = true and dataIndex < m.filteredChannels.count()
                if m.searchFocus = "channels" and dataIndex = m.channelIndex
                    if node.bg <> invalid then node.bg.color = "0xFFFFFFFF"
                    if node.numLabel <> invalid then node.numLabel.color = "0x090D16FF"
                    if node.logoLabel <> invalid then node.logoLabel.color = "0x090D16FF"
                    if node.nameLabel <> invalid then node.nameLabel.color = "0x090D16FF"
                else
                    if node.bg <> invalid then node.bg.color = "0x111827FF"
                    if node.numLabel <> invalid then node.numLabel.color = "0x94A3B8FF"
                    if node.logoLabel <> invalid then node.logoLabel.color = "0x38BDF8FF"
                    if node.nameLabel <> invalid then node.nameLabel.color = "0xF1F5F9FF"
                end if
            end if
        end if
    end for
    for r = 0 to m.keyboardNodes.count() - 1
        if r < m.keyboardNodes.count()
            rowNodes = m.keyboardNodes[r]
            for c = 0 to rowNodes.count() - 1
                if c < rowNodes.count()
                    keyNode = rowNodes[c]
                    if m.searchFocus = "keyboard" and r = m.kbRow and c = m.kbCol
                        if keyNode.bg <> invalid then keyNode.bg.color = "0xFFFFFFFF"
                        if keyNode.label <> invalid then keyNode.label.color = "0x090D16FF"
                    else
                        if keyNode.bg <> invalid then keyNode.bg.color = "0x111827FF"
                        if keyNode.label <> invalid then keyNode.label.color = "0xE2E8F0FF"
                    end if
                end if
            end for
        end if
    end for
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub updatePlayerUi()
    if m.appState <> "player" then return
    if m.currentPreviewChannel <> invalid
        ch = m.currentPreviewChannel
        if m.playerNumberLabel <> invalid then m.playerNumberLabel.text = ch.num.toStr()
        if m.playerNameLabel <> invalid then m.playerNameLabel.text = ch.name
        if m.playerCategoryLabel <> invalid
            if ch.DoesExist("category") and ch.category <> invalid
                m.playerCategoryLabel.text = UCase(ch.category)
            else
                m.playerCategoryLabel.text = ""
            end if
        end if

        hasLogo = (ch.DoesExist("logo") and ch.logo <> invalid and ch.logo <> "")
        if m.playerChannelLogo <> invalid
            if hasLogo
                m.playerChannelLogo.uri = ch.logo
                m.playerChannelLogo.visible = true
                if m.playerChannelLogoBg <> invalid then m.playerChannelLogoBg.visible = true
            else
                m.playerChannelLogo.visible = false
                if m.playerChannelLogoBg <> invalid then m.playerChannelLogoBg.visible = false
            end if
        end if

        if m.playerFavBadgeGroup <> invalid
            m.playerFavBadgeGroup.visible = isChannelFavorite(ch.url)
        end if
        if m.playerResBadge <> invalid
            m.playerResBadge.text = m.videoResolutionLabel
        end if
        if m.playerAspectBadge <> invalid
            aspectTxt = "16:9"
            if m.aspectMode = "fit" then aspectTxt = "ORIGINAL"
            if m.aspectMode = "zoom" then aspectTxt = "ZOOM"
            m.playerAspectBadge.text = aspectTxt
        end if
    end if
    updateStreamStatusOverlays()
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub updatePlaylistsUi()
    if m.appState <> "playlists" then return
    refreshPlaylistRows()
    for i = 0 to m.playlistRowNodes.count() - 1
        if i < m.playlistRowNodes.count()
            node = m.playlistRowNodes[i]
            if node.row <> invalid and node.row.visible = true
                if m.playlistFocus = i
                    if node.border <> invalid then node.border.color = "0x38BDF8FF"
                    if node.bg <> invalid then node.bg.color = "0xFFFFFFFF"
                    if node.numBg <> invalid then node.numBg.color = "0x090D16FF"
                    if node.num <> invalid then node.num.color = "0xFFFFFFFF"
                    if node.name <> invalid then node.name.color = "0x090D16FF"
                else
                    if node.border <> invalid then node.border.color = "0xFFFFFF18"
                    if node.bg <> invalid then node.bg.color = "0x0F1624FF"
                    if node.numBg <> invalid then node.numBg.color = "0xFFFFFF16"
                    if node.num <> invalid then node.num.color = "0x94A3B8FF"
                    if node.name <> invalid then node.name.color = "0xF8FAFCFF"
                end if
            end if
        end if
    end for
    if m.refreshBtnBg <> invalid
        if m.playlistFocus = 100
            m.refreshBtnBg.color = "0x38BDF8FF"
        else
            m.refreshBtnBg.color = "0x111827FF"
        end if
    end if
    if m.addBtnBg <> invalid
        if m.playlistFocus = 101
            m.addBtnBg.color = "0x38BDF8FF"
        else
            m.addBtnBg.color = "0x111827FF"
        end if
    end if
    if m.trashBtnBg <> invalid
        if m.playlistFocus = 102
            m.trashBtnBg.color = "0xF43F5EFF"
        else
            m.trashBtnBg.color = "0x111827FF"
        end if
    end if
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub updateAddPlaylistUi()
    if m.appState <> "addPlaylist" then return
    refreshAddPlaylistFieldText()
    if m.addPlaylistMode = "xtream"
        if m.xtreamTabBg <> invalid then m.xtreamTabBg.color = "0xFFFFFFFF"
        if m.xtreamTabLabel <> invalid then m.xtreamTabLabel.color = "0x090D16FF"
        if m.m3uTabBg <> invalid then m.m3uTabBg.color = "0x141C2BFF"
        if m.m3uTabLabel <> invalid then m.m3uTabLabel.color = "0xE2E8F0FF"
    else
        if m.xtreamTabBg <> invalid then m.xtreamTabBg.color = "0x141C2BFF"
        if m.xtreamTabLabel <> invalid then m.xtreamTabLabel.color = "0xE2E8F0FF"
        if m.m3uTabBg <> invalid then m.m3uTabBg.color = "0xFFFFFFFF"
        if m.m3uTabLabel <> invalid then m.m3uTabLabel.color = "0x090D16FF"
    end if
    for i = 0 to m.addPlaylistFieldNodes.count() - 1
        if i < m.addPlaylistFieldNodes.count()
            node = m.addPlaylistFieldNodes[i]
            if m.addPlaylistFocus = i + 2
                if node.bg <> invalid then node.bg.color = "0xFFFFFFFF"
                if node.label <> invalid then node.label.color = "0x090D16FF"
            else
                if node.bg <> invalid then node.bg.color = "0x111827FF"
                if node.label <> invalid then node.label.color = "0xE2E8F0FF"
            end if
        end if
    end for
    if m.addPlaylistFocus = 0
        if m.xtreamTabBg <> invalid then m.xtreamTabBg.color = "0x38BDF8FF"
        if m.xtreamTabLabel <> invalid then m.xtreamTabLabel.color = "0x090D16FF"
    end if
    if m.addPlaylistFocus = 1
        if m.m3uTabBg <> invalid then m.m3uTabBg.color = "0x38BDF8FF"
        if m.m3uTabLabel <> invalid then m.m3uTabLabel.color = "0x090D16FF"
    end if
    if m.addPlaylistFocus = 5
        if m.cancelBtnBg <> invalid then m.cancelBtnBg.color = "0xFFFFFFFF"
        if m.cancelBtnLabel <> invalid then m.cancelBtnLabel.color = "0x090D16FF"
    else
        if m.cancelBtnBg <> invalid then m.cancelBtnBg.color = "0x141C2BFF"
        if m.cancelBtnLabel <> invalid then m.cancelBtnLabel.color = "0xFFFFFFFF"
    end if
    if m.addPlaylistFocus = 6
        if m.okBtnBg <> invalid then m.okBtnBg.color = "0x10B981FF"
        if m.okBtnLabel <> invalid then m.okBtnLabel.color = "0xFFFFFFFF"
    else
        if m.okBtnBg <> invalid then m.okBtnBg.color = "0x141C2BFF"
        if m.okBtnLabel <> invalid then m.okBtnLabel.color = "0xFFFFFFFF"
    end if
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub updateSettingsUi()
    if m.appState <> "settings" then return
    for i = 0 to m.settingsRowNodes.count() - 1
        if i < m.settingsRowNodes.count()
            node = m.settingsRowNodes[i]
            if i = m.settingsFocus
                if node.border <> invalid then node.border.color = "0x38BDF899"
                if node.bg <> invalid then node.bg.color = "0x182236FF"
                if node.stripe <> invalid then node.stripe.opacity = 1.0
                if node.label <> invalid then node.label.color = "0xFFFFFFFF"
            else
                if node.border <> invalid then node.border.color = "0xFFFFFF18"
                if node.bg <> invalid then node.bg.color = "0x0F1624FF"
                if node.stripe <> invalid then node.stripe.opacity = 0.0
                if node.label <> invalid then node.label.color = "0xCBD5E1FF"
            end if
        end if
    end for
    setToggleVisual(0, m.settingXtreamEpg)
    setToggleVisual(1, m.settingTmdb)
    setToggleVisual(4, m.categoriesLocked)
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub setToggleVisual(index as Integer, enabled as Boolean)
    if index < m.settingsRowNodes.count()
        node = m.settingsRowNodes[index]
        if enabled
            if node.toggleBg <> invalid then node.toggleBg.color = "0x10B981FF"
            if node.toggleDot <> invalid then node.toggleDot.translation = [577, 17]
            if node.toggleDot <> invalid then node.toggleDot.color = "0xFFFFFFFF"
        else
            if node.toggleBg <> invalid then node.toggleBg.color = "0x334155FF"
            if node.toggleDot <> invalid then node.toggleDot.translation = [553, 17]
            if node.toggleDot <> invalid then node.toggleDot.color = "0xCBD5E1FF"
        end if
    end if
end sub

sub updateEntryUi()
    if m.entryOpen = false then return
    if m.entryValueLabel <> invalid then m.entryValueLabel.text = m.entryText
    for r = 0 to m.entryNodes.count() - 1
        if r < m.entryNodes.count()
            row = m.entryNodes[r]
            for c = 0 to row.count() - 1
                if c < row.count()
                    node = row[c]
                    if r = m.entryRow and c = m.entryCol
                        if node.bg <> invalid then node.bg.color = "0xFFFFFFFF"
                        if node.label <> invalid then node.label.color = "0x090D16FF"
                    else
                        if node.bg <> invalid then node.bg.color = "0x151E2EFF"
                        if node.label <> invalid then node.label.color = "0xE2E8F0FF"
                    end if
                end if
            end for
        end if
    end for
end sub

sub openSoon(title as String, desc as String)
    m.modalOpen = true
    if m.soonTitleLabel <> invalid then m.soonTitleLabel.text = title
    if m.soonTextLabel <> invalid then m.soonTextLabel.text = desc
    updateAllUi()
end sub

sub closeSoon()
    m.modalOpen = false
    updateAllUi()
end sub

sub enterCategory(item as Object)
    if item = invalid then return
    m.regionalState = "channels"
    m.lastCategoryIndex = m.leftIndex
    m.currentCategoryChannels = []

    if item.type = "favorite"
        for each ch in m.channels
            if isChannelFavorite(ch.url)
                m.currentCategoryChannels.push({label: ch.name, type: "channel", channelData: ch})
            end if
        end for
        if m.currentCategoryChannels.count() = 0
            showToast("Sin favoritos aún · Presiona * o Derecha sobre un canal para guardarlo")
            m.regionalState = "categories"
            return
        end if
    else if item.type = "recent"
        for each recUrl in m.recentUrls
            for each ch in m.channels
                if ch.url = recUrl
                    m.currentCategoryChannels.push({label: ch.name, type: "channel", channelData: ch})
                    exit for
                end if
            end for
        end for
        if m.currentCategoryChannels.count() = 0
            showToast("Aún no hay canales recientes reproducidos")
            m.regionalState = "categories"
            return
        end if
    else
        for each ch in m.channels
            if ch.category = item.id
                m.currentCategoryChannels.push({label: ch.name, type: "channel", channelData: ch})
            end if
        end for
    end if

    m.leftNavItems = m.currentCategoryChannels
    m.leftIndex = 0
    m.leftNavTop = 0
    adjustLeftNavWindow()
    updateRegionalUi()
end sub

sub openRegional()
    m.appState = "regional"
    m.homeFocus = "left"
    m.regionalState = "categories"

    if m.categories.count() > 0
        m.leftNavItems = m.categories
    end if
    m.leftIndex = m.lastCategoryIndex
    adjustLeftNavWindow()

    if m.channels.count() = 0
        showSyncStatus(auraText("syncing"))
        if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
        if m.playlists.count() > 0
            loadChannelsFromPlaylist(m.playlists[0])
        else
            syncPlaylistsFromWeb(false)
        end if
    else
        if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
    end if

    updateAllUi()
end sub

sub stopVideoPlaybackClean()
    clearPlaybackWatchdog()
    if m.osdBannerTimer <> invalid then m.osdBannerTimer.control = "stop"
    if m.videoPlayer <> invalid then m.videoPlayer.control = "stop"
    if m.videoPlayer <> invalid then m.videoPlayer.visible = false
    if m.previewPoster <> invalid then m.previewPoster.visible = true
    m.currentPreviewChannel = invalid
    m.currentPlayerStatus = "idle"
    m.currentPlayerDetail = ""
    updateStreamStatusOverlays()
end sub

sub openSearch()
    stopVideoPlaybackClean()
    m.appState = "search"
    m.searchFocus = "keyboard"
    m.kbRow = 0
    m.kbCol = 0
    updateAllUi()
end sub

function getStreamFormat(url as String) as String
    lUrl = LCase(url)
    if Instr(1, lUrl, ".m3u8") > 0 then return "hls"
    if Instr(1, lUrl, ".ts") > 0 then return "ts"
    if Instr(1, lUrl, ".mp4") > 0 then return "mp4"
    return "hls"
end function

' ---- PRIMER OK: VISTA PREVIA (VIRTUALIZADA Y SEGURA) ----
sub openPlayerPreview(item as Object)
    if item = invalid then return
    recordRecentChannel(item)
    m.currentPreviewChannel = item
    m.currentPlayerStatus = "loading"
    m.currentPlayerDetail = ""
    m.reconnectAttempts = 0
    m.videoResolutionLabel = "LIVE"

    if m.playerNameLabel <> invalid then m.playerNameLabel.text = item.name
    if m.playerNumberLabel <> invalid then m.playerNumberLabel.text = item.num.toStr()
    if m.playerCategoryLabel <> invalid
        if item.DoesExist("category") and item.category <> invalid
            m.playerCategoryLabel.text = UCase(item.category)
        else
            m.playerCategoryLabel.text = ""
        end if
    end if

    updateStreamStatusOverlays()
    startPlaybackWatchdog()

    if m.videoPlayer = invalid then return

    videoContent = CreateObject("roSGNode", "ContentNode")
    videoContent.url = item.url
    videoContent.title = item.name
    videoContent.streamFormat = getStreamFormat(item.url)

    m.videoPlayer.content = videoContent
    m.videoPlayer.control = "play"

    if m.previewPoster <> invalid
        m.previewPoster.visible = false
        m.videoPlayer.translation = m.previewPoster.translation
        m.videoPlayer.width = m.previewPoster.width
        m.videoPlayer.height = m.previewPoster.height
        m.videoPlayer.visible = true
    end if
end sub

' ---- SEGUNDO OK: PANTALLA COMPLETA ----
sub openPlayerFull()
    m.lastStateBeforePlayer = m.appState
    m.appState = "player"
    closeMiniGuide()
    updateAllUi()
    showPlayerOsdBanner()

    if m.videoPlayer = invalid then return

    applyAspectRatioToVideo()
    m.videoPlayer.visible = true
end sub

sub playChannelInFullscreenDirect(nextCh as Object)
    if nextCh = invalid then return
    recordRecentChannel(nextCh)
    m.currentPreviewChannel = nextCh
    m.currentPlayerStatus = "loading"
    m.currentPlayerDetail = ""
    m.reconnectAttempts = 0
    m.videoResolutionLabel = "LIVE"

    list = getActivePlayerChannelList()
    if list <> invalid and m.regionalState = "channels" and m.currentCategoryChannels.count() > 0
        for i = 0 to list.count() - 1
            if list[i].url = nextCh.url
                m.leftIndex = i
                adjustLeftNavWindow()
                exit for
            end if
        end for
    end if

    updatePlayerUi()
    if m.miniGuideOpen then updateMiniGuideUi()
    showPlayerOsdBanner()
    startPlaybackWatchdog()

    if m.videoPlayer <> invalid
        videoContent = CreateObject("roSGNode", "ContentNode")
        videoContent.url = nextCh.url
        videoContent.title = nextCh.name
        videoContent.streamFormat = getStreamFormat(nextCh.url)
        m.videoPlayer.content = videoContent
        applyAspectRatioToVideo()
        m.videoPlayer.visible = true
        m.videoPlayer.control = "play"
    end if
end sub

sub switchChannelInFullscreen(delta as Integer)
    list = getActivePlayerChannelList()
    if list = invalid or list.count() = 0 then return

    idx = 0
    if m.currentPreviewChannel <> invalid
        for i = 0 to list.count() - 1
            if list[i].url = m.currentPreviewChannel.url
                idx = i
                exit for
            end if
        end for
    end if
    idx = (idx + delta + list.count()) MOD list.count()
    playChannelInFullscreenDirect(list[idx])
end sub

sub openPlaylists()
    m.appState = "playlists"
    if m.playlists.count() > 0
        m.playlistFocus = 0
    else
        m.playlistFocus = 100
    end if
    if m.playlistSyncStatus <> invalid then m.playlistSyncStatus.text = auraText("syncing")
    updateAllUi()
    syncPlaylistsFromWeb(false)
end sub

sub openAddPlaylist()
    m.appState = "addPlaylist"
    m.addPlaylistFocus = 0
    m.addPlaylistMode = "xtream"
    if m.addPlaylistStatus <> invalid then m.addPlaylistStatus.text = ""
    updateAllUi()
end sub

sub openSettings()
    m.appState = "settings"
    m.settingsFocus = 0
    updateAllUi()
end sub

sub openEntry(field as String)
    m.entryOpen = true
    m.entryField = field
    m.entryRow = 0
    m.entryCol = 0
    if m.entryTitleLabel <> invalid
        if field = "host"
            m.entryTitleLabel.text = auraText("host")
            m.entryText = m.addHost
        else if field = "username"
            m.entryTitleLabel.text = auraText("username")
            m.entryText = m.addUsername
        else if field = "password"
            m.entryTitleLabel.text = auraText("password")
            m.entryText = m.addPassword
        else if field = "pinset"
            m.entryTitleLabel.text = auraText("enter_pin")
            m.entryText = ""
        else if field = "unlock"
            m.entryTitleLabel.text = auraText("unlock_cat")
            m.entryText = ""
        else
            m.entryTitleLabel.text = auraText("password")
            m.entryText = ""
        end if
    end if
    if m.entryOverlayGroup <> invalid then m.entryOverlayGroup.visible = true
    updateEntryUi()
end sub

sub closeEntry(saveValue as Boolean)
    if saveValue
        if m.entryField = "host" then m.addHost = m.entryText
        if m.entryField = "username" then m.addUsername = m.entryText
        if m.entryField = "password" then m.addPassword = m.entryText
        if m.entryField = "pinset"
            pinv = sanitizeDigits(m.entryText)
            if Len(pinv) >= 4
                m.parentalPin = Left(pinv, 4)
                savePrefs()
                m.entryOpen = false
                if m.pendingLockedCategory <> invalid
                    pendingItem = m.pendingLockedCategory
                    m.pendingLockedCategory = invalid
                    m.unlockGranted = true
                    updateAllUi()
                    enterCategory(pendingItem)
                else
                    updateAllUi()
                    openSoon(auraText("pin_saved_title"), auraText("pin_saved_desc"))
                end if
                return
            else
                m.entryOpen = false
                updateAllUi()
                openSoon(auraText("pin_invalid_title"), auraText("pin_invalid_desc"))
                return
            end if
        end if
        if m.entryField = "unlock"
            pinv = sanitizeDigits(m.entryText)
            if pinv = m.parentalPin and m.parentalPin <> ""
                m.unlockGranted = true
                m.entryOpen = false
                if m.pendingLockedCategory <> invalid
                    pendingItem = m.pendingLockedCategory
                    m.pendingLockedCategory = invalid
                    updateAllUi()
                    enterCategory(pendingItem)
                else
                    updateAllUi()
                end if
                return
            else
                m.entryOpen = false
                updateAllUi()
                openSoon(auraText("access_denied"), auraText("access_denied_desc"))
                return
            end if
        end if
    end if
    m.entryOpen = false
    updateAllUi()
end sub

sub backToLauncher()
    m.appState = "launcher"
    m.unlockGranted = false
    m.pendingLockedCategory = invalid
    stopVideoPlaybackClean()
    updateAllUi()
end sub
' --- TECLADO DE BÚSQUEDA, PLAYLISTS, BACKEND Y NAVEGACIÓN REMOTA (D-PAD) ---
sub applyKeyboardValue(value as String)
    if value = "DEL"
        if Len(m.searchQuery) > 0 then m.searchQuery = Left(m.searchQuery, Len(m.searchQuery) - 1)
    else if value = "SPACE"
        m.searchQuery = m.searchQuery + " "
    else if value = "CLEAN"
        m.searchQuery = ""
    else if value = "DONE"
        m.searchFocus = "channels"
    else if value = "SHIFT"
    else if value = "123"
    else
        m.searchQuery = m.searchQuery + value
    end if
    if m.filteredChannels.count() > 0
        m.channelIndex = 0
        m.channelTop = 0
    end if
    refreshSearchResults()
    updateSearchUi()
end sub

sub moveKeyboardHorizontal(delta as Integer)
    rowNodes = m.keyboardNodes[m.kbRow]
    newCol = m.kbCol + delta
    if newCol < 0 then newCol = 0
    if newCol >= rowNodes.count() then newCol = rowNodes.count() - 1
    m.kbCol = newCol
    updateSearchUi()
end sub

sub moveKeyboardVertical(delta as Integer)
    newRow = m.kbRow + delta
    if newRow < 0 then newRow = 0
    if newRow >= m.keyboardNodes.count() then newRow = m.keyboardNodes.count() - 1
    m.kbRow = newRow
    rowNodes = m.keyboardNodes[m.kbRow]
    if m.kbCol >= rowNodes.count() then m.kbCol = rowNodes.count() - 1
    updateSearchUi()
end sub

sub moveChannelSelection(delta as Integer)
    if m.filteredChannels.count() = 0 then return
    newIndex = m.channelIndex + delta
    if newIndex < 0 then newIndex = 0
    if newIndex >= m.filteredChannels.count() then newIndex = m.filteredChannels.count() - 1
    m.channelIndex = newIndex
    adjustChannelWindow()
    refreshSearchChannelRows()
    updateSearchUi()
end sub

sub moveEntryHorizontal(delta as Integer)
    row = m.entryNodes[m.entryRow]
    newCol = m.entryCol + delta
    if newCol < 0 then newCol = 0
    if newCol >= row.count() then newCol = row.count() - 1
    m.entryCol = newCol
    updateEntryUi()
end sub

sub moveEntryVertical(delta as Integer)
    newRow = m.entryRow + delta
    if newRow < 0 then newRow = 0
    if newRow >= m.entryNodes.count() then newRow = m.entryNodes.count() - 1
    m.entryRow = newRow
    row = m.entryNodes[m.entryRow]
    if m.entryCol >= row.count() then m.entryCol = row.count() - 1
    updateEntryUi()
end sub

sub applyEntryValue(value as String)
    if value = "DEL"
        if Len(m.entryText) > 0 then m.entryText = Left(m.entryText, Len(m.entryText) - 1)
    else if value = "SPACE"
        m.entryText = m.entryText + " "
    else if value = "DONE"
        closeEntry(true)
        return
    else
        m.entryText = m.entryText + value
    end if
    updateEntryUi()
end sub

sub saveNewPlaylist()
    if m.addPlaylistMode = "xtream" and (m.addHost = "" or m.addUsername = "" or m.addPassword = "")
        if m.addPlaylistStatus <> invalid then m.addPlaylistStatus.text = auraText("add_required")
        return
    end if
    name = "Mi TV"
    if m.addUsername <> "" then name = m.addUsername
    urlVal = ""
    if m.addPlaylistMode = "m3u" then urlVal = m.addHost
    item = {id:"local-" + m.playlists.count().toStr(), name:name, type:m.addPlaylistMode, host:m.addHost, username:m.addUsername, password:m.addPassword, url:urlVal}
    m.playlists.push(item)
    pushPlaylistToWeb(item)
    if m.addPlaylistStatus <> invalid then m.addPlaylistStatus.text = auraText("add_success")
    m.addHost = ""
    m.addUsername = ""
    m.addPassword = ""
    openPlaylists()
end sub

sub deleteSelectedPlaylist()
    if m.playlists.count() = 0 then return
    index = 0
    if m.playlistFocus >= 0 and m.playlistFocus < m.playlists.count() then index = m.playlistFocus
    itemId = m.playlists[index].id
    deletePlaylistFromWeb(itemId)
    m.playlists.delete(index)
    if m.playlists.count() = 0
        m.playlistFocus = 101
    else if index >= m.playlists.count()
        m.playlistFocus = m.playlists.count() - 1
    else
        m.playlistFocus = index
    end if
    if m.playlistSyncStatus <> invalid then m.playlistSyncStatus.text = auraText("playlist_deleted")
    updatePlaylistsUi()
end sub

sub pushPlaylistToWeb(item as Object)
    m.apiTask = CreateObject("roSGNode", "BackendTask")
    m.apiTask.request = {url: m.backendBaseUrl, method: "POST", payload: {action:"upsert", mac:m.deviceMac, key:m.deviceKey, playlist:item}, action: "upsert", insecure:false}
    m.apiTask.observeField("response", "onApiResponse")
    m.apiTask.control = "RUN"
end sub

sub deletePlaylistFromWeb(itemId as String)
    m.apiTask = CreateObject("roSGNode", "BackendTask")
    m.apiTask.request = {url: m.backendBaseUrl, method: "POST", payload: {action:"delete", mac:m.deviceMac, key:m.deviceKey, id:itemId}, action: "delete", insecure:false}
    m.apiTask.observeField("response", "onApiResponse")
    m.apiTask.control = "RUN"
end sub

sub showSyncStatus(message as String)
    if m.syncStatusLabel <> invalid then m.syncStatusLabel.text = message
end sub

sub hideSyncStatus()
    if m.syncStatusLabel <> invalid then m.syncStatusLabel.text = ""
end sub

function normalizeHostUrl(rawHost as String) as String
    trimmed = rawHost.Trim()
    while Len(trimmed) > 0 and Right(trimmed, 1) = "/"
        trimmed = Left(trimmed, Len(trimmed) - 1)
    end while
    if trimmed = "" then return ""
    lUrl = LCase(trimmed)
    if Left(lUrl, 7) <> "http://" and Left(lUrl, 8) <> "https://"
        return "http://" + trimmed
    end if
    return trimmed
end function

function samePlaylist(a as Object, b as Object) as Boolean
    if a = invalid or b = invalid then return false
    if a.type <> b.type then return false
    if a.type = "xtream"
        if normalizeHostUrl(a.host) <> normalizeHostUrl(b.host) then return false
        if a.username <> b.username then return false
        if a.password <> b.password then return false
        return true
    end if
    urlA = ""
    urlB = ""
    if a.DoesExist("url") and a.url <> "" then urlA = a.url else if a.DoesExist("host") then urlA = a.host
    if b.DoesExist("url") and b.url <> "" then urlB = b.url else if b.DoesExist("host") then urlB = b.host
    return urlA = urlB
end function

sub onAutoSyncTimerFired()
    syncPlaylistsFromWeb(true)
end sub

sub syncPlaylistsFromWeb(isBackground = false as Boolean)
    if m.appState = "player" and m.channels.count() > 0 then return
    if m.appState = "search" then return
    if m.appState = "movies" then return

    if isBackground and m.appState = "addons" and m.addonDirectQueueIndex >= m.addonDirectQueue.count()
        requestAddonsList(true)
    end if

    dt = CreateObject("roDateTime")
    nowSec = 0
    if dt <> invalid then nowSec = dt.AsSeconds()

    if m.syncInFlight and (nowSec - m.syncStartedAt) < 8
        return
    end if

    m.syncInFlight = true
    m.syncStartedAt = nowSec
    startSyncWheelAnimation()

    if not isBackground or m.playlists.count() = 0
        showSyncStatus(auraText("syncing"))
    end if
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""

    m.apiTask = CreateObject("roSGNode", "BackendTask")
    url = m.backendBaseUrl + "?action=get&mac=" + m.deviceMac.EncodeUriComponent() + "&key=" + m.deviceKey.EncodeUriComponent() + "&_t=" + nowSec.toStr()
    m.apiTask.request = {url: url, method: "GET", action: "sync", insecure:false}
    m.apiTask.observeField("response", "onApiResponse")
    m.apiTask.control = "RUN"
end sub

sub loadChannelsFromPlaylist(pl as Object)
    if pl = invalid then return
    dt = CreateObject("roDateTime")
    nowSec = 0
    if dt <> invalid then nowSec = dt.AsSeconds()

    if m.channelLoadInFlight and (nowSec - m.channelLoadStartedAt) < 20 and samePlaylist(pl, m.pendingPlaylistToLoad)
        return
    end if

    m.channelLoadInFlight = true
    m.channelLoadStartedAt = nowSec
    m.pendingPlaylistToLoad = pl
    startSyncWheelAnimation()
    showSyncStatus(auraText("syncing"))
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""

    rawUrl = ""
    if pl.DoesExist("url") and pl.url <> "" then rawUrl = pl.url.Trim()
    if rawUrl = "" and pl.DoesExist("host") then rawUrl = pl.host.Trim()

    isDirectM3u = (pl.type = "m3u")
    if not isDirectM3u and pl.username = "" and (Instr(1, LCase(rawUrl), ".m3u") > 0)
        isDirectM3u = true
    end if

    m.apiTask = CreateObject("roSGNode", "BackendTask")
    if not isDirectM3u and pl.type = "xtream"
        cleanHost = normalizeHostUrl(pl.host)
        url = cleanHost + "/player_api.php?username=" + pl.username.EncodeUriComponent() + "&password=" + pl.password.EncodeUriComponent() + "&action=get_live_streams"
        m.apiTask.request = {url: url, method: "GET", action: "fetch_xtream", insecure:true}
    else
        m3uUrl = normalizeHostUrl(rawUrl)
        m.apiTask.request = {url: m3uUrl, method: "GET", action: "fetch_m3u", raw: true, insecure:true}
    end if

    m.apiTask.observeField("response", "onApiResponse")
    m.apiTask.control = "RUN"
end sub

sub rebuildCategoriesFromChannels()
    m.categories = [
        {label: "* " + auraText("favorites") + " (" + m.favoriteUrls.count().toStr() + ")", type: "favorite"},
        {label: "Recientes (" + m.recentUrls.count().toStr() + ")", type: "recent"},
        {label: auraText("search_all"), type: "search"}
    ]
    counts = {}
    uniqueCats = {}
    for each ch in m.channels
        c = ch.category
        if c = invalid or c = "" then c = auraText("general_channels")
        if counts.DoesExist(c)
            counts[c] = counts[c] + 1
        else
            counts[c] = 1
        end if
    end for
    for each ch in m.channels
        if ch.category <> invalid and ch.category <> "" and not uniqueCats.DoesExist(ch.category)
            uniqueCats[ch.category] = true
            cnt = 0
            if counts.DoesExist(ch.category) then cnt = counts[ch.category]
            m.categories.push({label: UCase(ch.category) + " (" + cnt.toStr() + ")", type: "category", id: ch.category})
        end if
    end for

    if m.regionalState <> "channels"
        m.regionalState = "categories"
        m.leftNavItems = m.categories
        if m.leftIndex >= m.leftNavItems.count() then m.leftIndex = 0
        adjustLeftNavWindow()
    end if
    refreshSearchResults()
    updateChannelStatsUi()
    updateRegionalUi()
    hideSyncStatus()
    if m.playlistSyncStatus <> invalid then m.playlistSyncStatus.text = auraText("synced") + " (" + m.channels.count().toStr() + " canales)"
    if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
end sub

sub onApiResponse()
    res = m.apiTask.response
    if res = invalid then return

    if Left(res.action, 6) = "movie_"
        handleMovieApiResponse(res)
        return
    end if
    if Left(res.action, 6) = "addon_"
        handleAddonsApiResponse(res)
        return
    end if

    if res.action = "sync"
        m.syncInFlight = false
        stopSyncWheelAnimation()

        if res.DoesExist("error")
            if m.playlistSyncStatus <> invalid then m.playlistSyncStatus.text = auraText("sync_error")
            if not m.channelLoadInFlight then hideSyncStatus()
            if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
        else if res.data <> invalid and res.data.DoesExist("playlists")
            prevCount = m.playlists.count()
            loaded = []
            if type(res.data.playlists) = "roArray"
                for each item in res.data.playlists
                    if item <> invalid
                        idVal = "web": nameVal = "Tv": typeVal = "xtream": hostVal = "": userVal = "": passVal = "": urlVal = ""
                        if item.DoesExist("id") and item.id <> invalid then idVal = item.id.toStr()
                        if item.DoesExist("name") and item.name <> invalid then nameVal = item.name.toStr()
                        if item.DoesExist("type") and item.type <> invalid then typeVal = item.type.toStr()
                        if item.DoesExist("host") and item.host <> invalid then hostVal = item.host.toStr()
                        if item.DoesExist("username") and item.username <> invalid then userVal = item.username.toStr()
                        if item.DoesExist("password") and item.password <> invalid then passVal = item.password.toStr()
                        if item.DoesExist("url") and item.url <> invalid then urlVal = item.url.toStr()
                        loaded.push({id:idVal, name:nameVal, type:typeVal, host:hostVal, username:userVal, password:passVal, url:urlVal})
                    end if
                end for
            end if

            m.playlists = loaded

            if m.playlists.count() > 0
                if prevCount = 0 or (m.playlistFocus < 100 and m.playlistFocus >= m.playlists.count())
                    m.playlistFocus = 0
                end if
                if m.playlistSyncStatus <> invalid then m.playlistSyncStatus.text = auraText("synced")
                if m.channels.count() = 0 or samePlaylist(m.playlists[0], m.currentLoadedPlaylist) = false
                    loadChannelsFromPlaylist(m.playlists[0])
                else if not m.channelLoadInFlight
                    hideSyncStatus()
                end if
            else
                if m.playlistFocus < 100 then m.playlistFocus = 101
                if m.playlistSyncStatus <> invalid then m.playlistSyncStatus.text = auraText("no_playlists")
                if not m.channelLoadInFlight then hideSyncStatus()
            end if
            if m.footerHintLabel <> invalid then m.footerHintLabel.text = ""
            updatePlaylistsUi()
        end if

    else if res.action = "fetch_xtream"
        m.channelLoadInFlight = false
        stopSyncWheelAnimation()
        pl = m.pendingPlaylistToLoad
        if pl = invalid then pl = m.currentLoadedPlaylist
        if pl = invalid and m.playlists.count() > 0 then pl = m.playlists[0]

        if res.data <> invalid and type(res.data) = "roArray" and pl <> invalid
            m.currentLoadedPlaylist = pl
            cleanHost = normalizeHostUrl(pl.host)
            newChannels = []
            for i = 0 to res.data.count() - 1
                item = res.data[i]
                if item <> invalid and item.DoesExist("stream_id") and item.stream_id <> invalid
                    chName = "Canal"
                    chCat = auraText("general_channels")
                    chLogo = ""
                    if item.DoesExist("name") and item.name <> invalid then chName = item.name.toStr()
                    if item.DoesExist("category_name") and item.category_name <> invalid and item.category_name.toStr() <> ""
                        chCat = item.category_name.toStr()
                    else if item.DoesExist("category_id") and item.category_id <> invalid
                        chCat = "Categoría " + item.category_id.toStr()
                    end if
                    if item.DoesExist("stream_icon") and item.stream_icon <> invalid
                        chLogo = item.stream_icon.toStr()
                    end if

                    ch = {
                        num: i + 1,
                        name: chName,
                        category: chCat,
                        logo: chLogo,
                        url: cleanHost + "/live/" + pl.username + "/" + pl.password + "/" + item.stream_id.toStr() + ".ts"
                    }
                    newChannels.push(ch)
                end if
            end for
            m.channels = newChannels
            rebuildCategoriesFromChannels()
        else if pl <> invalid and pl.host <> "" and pl.username <> "" and pl.password <> ""
            cleanHost = normalizeHostUrl(pl.host)
            fallbackM3uUrl = cleanHost + "/get.php?username=" + pl.username.EncodeUriComponent() + "&password=" + pl.password.EncodeUriComponent() + "&type=m3u_plus&output=ts"
            m.channelLoadInFlight = true
            m.apiTask = CreateObject("roSGNode", "BackendTask")
            m.apiTask.request = {url: fallbackM3uUrl, method: "GET", action: "fetch_m3u", raw: true, insecure:true}
            m.apiTask.observeField("response", "onApiResponse")
            m.apiTask.control = "RUN"
        else
            hideSyncStatus()
        end if

    else if res.action = "fetch_m3u"
        m.channelLoadInFlight = false
        stopSyncWheelAnimation()
        pl = m.pendingPlaylistToLoad
        if pl = invalid then pl = m.currentLoadedPlaylist
        if pl = invalid and m.playlists.count() > 0 then pl = m.playlists[0]

        if res.rawData <> invalid
            if pl <> invalid then m.currentLoadedPlaylist = pl
            lines = res.rawData.Tokenize(chr(10))
            newChannels = []
            count = 1
            name = auraText("unknown_channel")
            category = auraText("general_channels")
            logo = ""

            for each line in lines
                line = line.Trim()
                if Left(line, 7) = "#EXTINF"
                    catMatch = Instr(1, line, "group-title=""")
                    if catMatch > 0
                        catStart = catMatch + 13
                        catEnd = Instr(catStart, line, """")
                        if catEnd > 0 then category = Mid(line, catStart, catEnd - catStart)
                    end if

                    logoMatch = Instr(1, line, "tvg-logo=""")
                    if logoMatch > 0
                        logoStart = logoMatch + 10
                        logoEnd = Instr(logoStart, line, """")
                        if logoEnd > 0 then logo = Mid(line, logoStart, logoEnd - logoStart)
                    end if

                    comma = Instr(1, line, ",")
                    if comma > 0 then name = Mid(line, comma + 1).Trim()
                else if Left(line, 4) = "http" or Left(line, 4) = "rtmp"
                    newChannels.push({num: count, name: name, url: line, category: category, logo: logo})
                    count = count + 1
                    name = auraText("unknown_channel")
                    category = auraText("general_channels")
                    logo = ""
                end if
            end for

            m.channels = newChannels
            rebuildCategoriesFromChannels()
        else
            hideSyncStatus()
        end if
    end if
end sub

function launcherMove(target as Integer) as Boolean
    if target >= 0 and target < m.launcherTiles.count()
        m.launcherTileIndex = target
        updateLauncherUi()
        return true
    end if
    return false
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if press = false then return false

    if m.appState = "splash"
        return true
    end if

    digit = extractDigitFromKey(key)
    if digit <> ""
        if handleNumberKey(digit) then return true
    end if

    if m.numericBuffer <> "" and key = "OK"
        commitNumericZap()
        return true
    end if

    if m.languageMenuOpen = true
        if key = "back"
            closeLanguageMenu()
            return true
        else if key = "up"
            m.languageMenuIndex = m.languageMenuIndex - 1
            if m.languageMenuIndex < 0 then m.languageMenuIndex = 2
            updateLanguageMenuUi()
            return true
        else if key = "down"
            m.languageMenuIndex = m.languageMenuIndex + 1
            if m.languageMenuIndex > 2 then m.languageMenuIndex = 0
            updateLanguageMenuUi()
            return true
        else if key = "OK"
            selectLanguageFromMenu()
            return true
        end if
        return true
    end if

    if m.modalOpen = true
        if key = "OK" or key = "back"
            closeSoon()
            return true
        end if
        return true
    end if

    if m.entryOpen = true
        if key = "back"
            closeEntry(false)
            return true
        else if key = "left"
            moveEntryHorizontal(-1)
            return true
        else if key = "right"
            moveEntryHorizontal(1)
            return true
        else if key = "up"
            moveEntryVertical(-1)
            return true
        else if key = "down"
            moveEntryVertical(1)
            return true
        else if key = "OK"
            value = m.entryNodes[m.entryRow][m.entryCol].value
            applyEntryValue(value)
            return true
        end if
        return true
    end if

    if m.appState = "launcher"
        if key = "left"
            if m.launcherTileIndex = 1 then return launcherMove(0)
            if m.launcherTileIndex = 2 then return launcherMove(1)
            if m.launcherTileIndex = 3 then return launcherMove(0)
            if m.launcherTileIndex = 4 then return launcherMove(3)
            if m.launcherTileIndex = 5 then return launcherMove(4)
        else if key = "right"
            if m.launcherTileIndex = 0 then return launcherMove(1)
            if m.launcherTileIndex = 1 then return launcherMove(2)
            if m.launcherTileIndex = 3 then return launcherMove(4)
            if m.launcherTileIndex = 4 then return launcherMove(5)
        else if key = "up"
            if m.launcherTileIndex = 3 then return launcherMove(0)
            if m.launcherTileIndex = 4 then return launcherMove(1)
            if m.launcherTileIndex = 5 then return launcherMove(2)
        else if key = "down"
            if m.launcherTileIndex = 0 then return launcherMove(3)
            if m.launcherTileIndex = 1 then return launcherMove(4)
            if m.launcherTileIndex = 2 then return launcherMove(5)
        else if key = "OK"
            tile = m.launcherTiles[m.launcherTileIndex]
            if tile.id = "live"
                openRegional()
            else if tile.id = "playlists"
                openPlaylists()
            else if tile.id = "movies"
                openMovies()
            else if tile.id = "series"
                openSoon(auraText("series"), auraText("series_soon"))
            else if tile.id = "settings"
                openSettings()
            else if tile.id = "addons"
                openAddons()
            end if
            return true
        end if
        return false
    end if

    if m.appState = "movies"
        return handleMoviesKey(key)
    end if

    if m.appState = "addons"
        return handleAddonsKey(key)
    end if

    if m.appState = "playlists"
        if key = "back"
            backToLauncher()
            return true
        end if

        if m.playlistFocus >= 0 and m.playlistFocus < m.playlists.count()
            if key = "up"
                if m.playlistFocus = 0
                    m.playlistFocus = 100
                else
                    m.playlistFocus = m.playlistFocus - 1
                end if
            else if key = "down"
                if m.playlistFocus < m.playlists.count() - 1 then m.playlistFocus = m.playlistFocus + 1
            else if key = "right"
                m.playlistFocus = 102
            else if key = "OK"
                loadChannelsFromPlaylist(m.playlists[m.playlistFocus])
                openRegional()
                return true
            end if
            updatePlaylistsUi()
            return true
        end if

        if m.playlistFocus = 100
            if key = "right" then m.playlistFocus = 101
            if key = "down" and m.playlists.count() > 0 then m.playlistFocus = 0
            if key = "OK" then syncPlaylistsFromWeb(false)
            updatePlaylistsUi()
            return true
        else if m.playlistFocus = 101
            if key = "left" then m.playlistFocus = 100
            if key = "down" and m.playlists.count() > 0 then m.playlistFocus = 0
            if key = "OK"
                openAddPlaylist()
                return true
            end if
            updatePlaylistsUi()
            return true
        else if m.playlistFocus = 102
            if key = "left"
                if m.playlists.count() > 0
                    m.playlistFocus = 0
                else
                    m.playlistFocus = 101
                end if
            else if key = "OK"
                deleteSelectedPlaylist()
            end if
            updatePlaylistsUi()
            return true
        end if
        return true
    end if

    if m.appState = "addPlaylist"
        if key = "back"
            openPlaylists()
            return true
        end if

        if m.addPlaylistFocus = 0 or m.addPlaylistFocus = 1
            if key = "left" then m.addPlaylistFocus = 0
            if key = "right" then m.addPlaylistFocus = 1
            if key = "down" then m.addPlaylistFocus = 2
            if key = "OK"
                if m.addPlaylistFocus = 0
                    m.addPlaylistMode = "xtream"
                else
                    m.addPlaylistMode = "m3u"
                end if
            end if
            updateAddPlaylistUi()
            return true
        end if

        if m.addPlaylistFocus >= 2 and m.addPlaylistFocus <= 4
            if key = "up"
                if m.addPlaylistFocus = 2
                    m.addPlaylistFocus = 0
                else
                    m.addPlaylistFocus = m.addPlaylistFocus - 1
                end if
            else if key = "down"
                if m.addPlaylistFocus = 4
                    m.addPlaylistFocus = 5
                else
                    m.addPlaylistFocus = m.addPlaylistFocus + 1
                end if
            else if key = "OK"
                if m.addPlaylistFocus = 2 then openEntry("host")
                if m.addPlaylistFocus = 3 then openEntry("username")
                if m.addPlaylistFocus = 4 then openEntry("password")
                return true
            end if
            updateAddPlaylistUi()
            return true
        end if

        if m.addPlaylistFocus = 5 or m.addPlaylistFocus = 6
            if key = "left" then m.addPlaylistFocus = 5
            if key = "right" then m.addPlaylistFocus = 6
            if key = "up" then m.addPlaylistFocus = 4
            if key = "OK"
                if m.addPlaylistFocus = 5
                    openPlaylists()
                else
                    saveNewPlaylist()
                end if
                return true
            end if
            updateAddPlaylistUi()
            return true
        end if
        return true
    end if

    if m.appState = "settings"
        if key = "back"
            backToLauncher()
            return true
        else if key = "up"
            m.settingsFocus = m.settingsFocus - 1
            if m.settingsFocus < 0 then m.settingsFocus = m.settingsItems.count() - 1
        else if key = "down"
            m.settingsFocus = m.settingsFocus + 1
            if m.settingsFocus >= m.settingsItems.count() then m.settingsFocus = 0
        else if key = "OK"
            if m.settingsFocus = 0
                m.settingXtreamEpg = not m.settingXtreamEpg
                savePrefs()
            else if m.settingsFocus = 1
                m.settingTmdb = not m.settingTmdb
                savePrefs()
            else if m.settingsFocus = 2
                cycleLanguage()
                return true
            else if m.settingsFocus = 3
                openEntry("pinset")
                return true
            else if m.settingsFocus = 4
                m.categoriesLocked = not m.categoriesLocked
                savePrefs()
            end if
        end if
        updateSettingsUi()
        return true
    end if

    ' CONTROLES PRO EN PANTALLA COMPLETA (Mini-Guía, Ping-Pong, Zapping, Favoritos, Formato de Pantalla)
    if m.appState = "player"
        if m.miniGuideOpen
            list = getActivePlayerChannelList()
            if key = "back" or key = "right" or key = "left"
                closeMiniGuide()
                return true
            else if key = "up" and list.count() > 0
                m.miniGuideIndex = (m.miniGuideIndex - 1 + list.count()) MOD list.count()
                updateMiniGuideUi()
                return true
            else if key = "down" and list.count() > 0
                m.miniGuideIndex = (m.miniGuideIndex + 1) MOD list.count()
                updateMiniGuideUi()
                return true
            else if key = "options" or key = "*" or key = "info"
                if m.miniGuideIndex >= 0 and m.miniGuideIndex < list.count()
                    toggleFavoriteChannel(list[m.miniGuideIndex])
                end if
                return true
            else if key = "OK" and list.count() > 0
                chosen = list[m.miniGuideIndex]
                if chosen <> invalid
                    playChannelInFullscreenDirect(chosen)
                    closeMiniGuide()
                end if
                return true
            end if
            return true
        end if

        if key = "back"
            if m.lastStateBeforePlayer = "search"
                stopVideoPlaybackClean()
                m.appState = "search"
                updateAllUi()
            else if m.lastStateBeforePlayer = "movies"
                stopVideoPlaybackClean()
                m.appState = "movies"
                m.movieMode = "detail"
                updateAllUi()
            else
                if m.lastStateBeforePlayer <> invalid
                    m.appState = m.lastStateBeforePlayer
                else
                    m.appState = "regional"
                end if
                updateAllUi()
                if m.videoPlayer <> invalid and m.previewPoster <> invalid
                    m.videoPlayer.translation = m.previewPoster.translation
                    m.videoPlayer.width = m.previewPoster.width
                    m.videoPlayer.height = m.previewPoster.height
                end if
            end if
            return true
        else if key = "up"
            if m.lastStateBeforePlayer <> "movies"
                switchChannelInFullscreen(-1)
            else
                showPlayerOsdBanner()
            end if
            return true
        else if key = "down"
            if m.lastStateBeforePlayer <> "movies"
                switchChannelInFullscreen(1)
            else
                showPlayerOsdBanner()
            end if
            return true
        else if key = "left"
            if m.lastStateBeforePlayer <> "movies"
                openMiniGuide()
            else
                showPlayerOsdBanner()
            end if
            return true
        else if key = "right"
            if m.lastStateBeforePlayer <> "movies"
                if m.previousChannel <> invalid and (m.currentPreviewChannel = invalid or m.previousChannel.url <> m.currentPreviewChannel.url)
                    prevCh = m.previousChannel
                    showToast("Canal anterior: " + prevCh.name)
                    playChannelInFullscreenDirect(prevCh)
                else
                    showToast("Aún no hay canal anterior para alternar")
                    showPlayerOsdBanner()
                end if
            else
                showPlayerOsdBanner()
            end if
            return true
        else if key = "options" or key = "*" or key = "info"
            if m.currentPreviewChannel <> invalid
                toggleFavoriteChannel(m.currentPreviewChannel)
            end if
            return true
        else if key = "OK"
            wasBannerVisible = (m.playerBannerBox <> invalid and m.playerBannerBox.visible = true)
            showPlayerOsdBanner()
            if m.currentPlayerStatus = "unavailable" and m.currentPreviewChannel <> invalid
                playChannelInFullscreenDirect(m.currentPreviewChannel)
            else if wasBannerVisible
                cycleAspectRatio()
            end if
            return true
        end if
        return false
    end if

    if m.appState = "search"
        if key = "back"
            stopVideoPlaybackClean()
            openRegional()
            return true
        end if
        if m.searchFocus = "keyboard"
            if key = "left"
                if m.kbCol > 0
                    moveKeyboardHorizontal(-1)
                else
                    m.searchFocus = "channels"
                    updateSearchUi()
                end if
                return true
            else if key = "right"
                moveKeyboardHorizontal(1)
                return true
            else if key = "up"
                moveKeyboardVertical(-1)
                return true
            else if key = "down"
                moveKeyboardVertical(1)
                return true
            else if key = "OK"
                value = m.keyboardNodes[m.kbRow][m.kbCol].value
                applyKeyboardValue(value)
                return true
            end if
        else if m.searchFocus = "channels"
            if key = "right"
                m.searchFocus = "keyboard"
                updateSearchUi()
                return true
            else if key = "up"
                moveChannelSelection(-1)
                return true
            else if key = "down"
                moveChannelSelection(1)
                return true
            else if key = "OK"
                if m.channelIndex >= 0 and m.channelIndex < m.filteredChannels.count()
                    selectedCh = m.filteredChannels[m.channelIndex]
                    openPlayerPreview(selectedCh)
                    openPlayerFull()
                end if
                return true
            end if
        end if
        return false
    end if

    ' NAVEGACIÓN EN TV EN VIVO (REGIONAL)
    if m.appState = "regional"
        if key = "back"
            if m.regionalState = "channels"
                m.regionalState = "categories"
                m.leftNavItems = m.categories
                m.leftIndex = m.lastCategoryIndex
                adjustLeftNavWindow()
                updateRegionalUi()
                return true
            end if
            stopVideoPlaybackClean()
            backToLauncher()
            return true
        end if

        if m.homeFocus = "left"
            if key = "up" and m.leftNavItems.count() > 0
                m.leftIndex = m.leftIndex - 1
                if m.leftIndex < 0 then m.leftIndex = m.leftNavItems.count() - 1
                adjustLeftNavWindow()
                updateRegionalUi()
                return true
            else if key = "down" and m.leftNavItems.count() > 0
                m.leftIndex = m.leftIndex + 1
                if m.leftIndex >= m.leftNavItems.count() then m.leftIndex = 0
                adjustLeftNavWindow()
                updateRegionalUi()
                return true
            else if key = "left" and m.regionalState = "channels"
                m.regionalState = "categories"
                m.leftNavItems = m.categories
                m.leftIndex = m.lastCategoryIndex
                adjustLeftNavWindow()
                updateRegionalUi()
                return true
            else if key = "options" or key = "*" or key = "info"
                if m.leftIndex >= 0 and m.leftIndex < m.leftNavItems.count()
                    item = m.leftNavItems[m.leftIndex]
                    if item <> invalid and item.type = "channel" and item.DoesExist("channelData") and item.channelData <> invalid
                        toggleFavoriteChannel(item.channelData)
                    end if
                end if
                return true
            else if key = "right"
                if m.leftIndex >= 0 and m.leftIndex < m.leftNavItems.count()
                    item = m.leftNavItems[m.leftIndex]
                    if item <> invalid and item.type = "channel" and item.DoesExist("channelData") and item.channelData <> invalid
                        toggleFavoriteChannel(item.channelData)
                        return true
                    end if
                end if
                m.homeFocus = "days"
                updateRegionalUi()
                return true
            else if key = "OK" and m.leftNavItems.count() > 0
                item = m.leftNavItems[m.leftIndex]
                if item.type = "search"
                    m.filteredChannels = m.channels
                    m.channelIndex = 0
                    m.channelTop = 0
                    refreshSearchChannelRows()
                    m.searchQuery = ""
                    if m.searchQueryLabel <> invalid then m.searchQueryLabel.text = auraText("search_placeholder")
                    openSearch()
                else if item.type = "favorite" or item.type = "recent"
                    enterCategory(item)
                else if item.type = "category"
                    if m.categoriesLocked and m.unlockGranted = false
                        m.pendingLockedCategory = item
                        if m.parentalPin = ""
                            openEntry("pinset")
                        else
                            openEntry("unlock")
                        end if
                    else
                        enterCategory(item)
                    end if
                else if item.type = "channel"
                    ch = item.channelData
                    if m.currentPreviewChannel <> invalid and m.currentPreviewChannel.url = ch.url
                        if m.currentPlayerStatus = "unavailable"
                            openPlayerPreview(ch)
                        else
                            openPlayerFull()
                        end if
                    else
                        openPlayerPreview(ch)
                    end if
                end if
                return true
            end if
        else if m.homeFocus = "days"
            if key = "left"
                m.homeFocus = "left"
                updateRegionalUi()
                return true
            else if key = "up"
                m.dayIndex = m.dayIndex - 1
                if m.dayIndex < 0 then m.dayIndex = m.days.count() - 1
                updateRegionalUi()
                return true
            else if key = "down"
                m.dayIndex = m.dayIndex + 1
                if m.dayIndex >= m.days.count() then m.dayIndex = 0
                updateRegionalUi()
                return true
            else if key = "OK"
                updateRegionalUi()
                return true
            end if
        end if
    end if

    return false
end function

' --- SINCRONIZACIÓN AUTOMÁTICA CONSTANTE EN SEGUNDO PLANO CADA 3 SEGUNDOS ---
sub startAutoSyncTimer()
    m.autoSyncTimer = CreateObject("roSGNode", "Timer")
    m.autoSyncTimer.duration = 3.0
    m.autoSyncTimer.repeat = true
    m.autoSyncTimer.observeField("fire", "onAutoSyncTimerFired")
    m.autoSyncTimer.control = "start"
end sub
