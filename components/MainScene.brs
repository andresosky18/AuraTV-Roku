function getKeyWidth(value as String) as Integer
    if value = "DEL" then return 56
    if value = "DONE" then return 92
    if value = "CLEAN" then return 92
    if value = "SHIFT" then return 56
    if value = "123" then return 56
    if value = "SPACE" then return 480
    if value = "\\" then return 42
    return 46
end function

