function weekdayLong(englishName as String) as String
    if m.language = "en" then return englishName
    if m.language = "zh"
        if englishName = "Monday" then return "Xingqi yi"
        if englishName = "Tuesday" then return "Xingqi er"
        if englishName = "Wednesday" then return "Xingqi san"
        if englishName = "Thursday" then return "Xingqi si"
        if englishName = "Friday" then return "Xingqi wu"
        if englishName = "Saturday" then return "Xingqi liu"
        return "Xingqi ri"
    end if
    if englishName = "Monday" then return "Lunes"
    if englishName = "Tuesday" then return "Martes"
    if englishName = "Wednesday" then return "Miércoles"
    if englishName = "Thursday" then return "Jueves"
    if englishName = "Friday" then return "Viernes"
    if englishName = "Saturday" then return "Sábado"
    return "Domingo"
end function

function weekdayShort(englishName as String) as String
    if m.language = "en"
        if englishName = "Monday" then return "Mon"
        if englishName = "Tuesday" then return "Tue"
        if englishName = "Wednesday" then return "Wed"
        if englishName = "Thursday" then return "Thu"
        if englishName = "Friday" then return "Fri"
        if englishName = "Saturday" then return "Sat"
        return "Sun"
    else if m.language = "zh"
        if englishName = "Monday" then return "Yi"
        if englishName = "Tuesday" then return "Er"
        if englishName = "Wednesday" then return "San"
        if englishName = "Thursday" then return "Si"
        if englishName = "Friday" then return "Wu"
        if englishName = "Saturday" then return "Liu"
        return "Ri"
    end if
    if englishName = "Monday" then return "Lun"
    if englishName = "Tuesday" then return "Mar"
    if englishName = "Wednesday" then return "Mié"
    if englishName = "Thursday" then return "Jue"
    if englishName = "Friday" then return "Vie"
    if englishName = "Saturday" then return "Sáb"
    return "Dom"
end function

function monthShort(monthNum as Integer) as String
    if m.language = "en"
        months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
        return months[monthNum - 1]
    else if m.language = "zh"
        return monthNum.toStr() + " yue"
    end if
    months = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"]
    return months[monthNum - 1]
end function

function sanitizeDigits(value as String) as String
    result = ""
    for i = 1 to Len(value)
        ch = Mid(value, i, 1)
        if ch >= "0" and ch <= "9" then result = result + ch
    end for
    return result
end function

function boolStr(value as Boolean) as String
    if value then return "1"
    return "0"
end function

sub savePrefs()
    sec = CreateObject("roRegistrySection", "AuraTV")
    if sec = invalid then return
    sec.Write("language", m.language)
    sec.Write("xtreamEpg", boolStr(m.settingXtreamEpg))
    sec.Write("tmdb", boolStr(m.settingTmdb))
    sec.Write("parentalPin", m.parentalPin)
    sec.Write("categoriesLocked", boolStr(m.categoriesLocked))
    sec.Write("favoriteUrls", FormatJson(m.favoriteUrls))
    sec.Write("recentUrls", FormatJson(m.recentUrls))
    sec.Write("lastWatchedUrl", m.lastWatchedUrl)
    sec.Write("lastWatchedName", m.lastWatchedName)
    sec.Flush()
end sub

sub loadPrefs()
    sec = CreateObject("roRegistrySection", "AuraTV")
    if sec = invalid then return

    lang = LCase(sec.Read("language"))
    if Left(lang, 2) = "es"
        m.language = "es"
    else if Left(lang, 2) = "zh"
        m.language = "zh"
    else
        m.language = "en"
    end if

    m.settingXtreamEpg = sec.Read("xtreamEpg") <> "0"
    m.settingTmdb = sec.Read("tmdb") <> "0"
    pinv = sec.Read("parentalPin")
    if pinv <> invalid then m.parentalPin = pinv
    m.categoriesLocked = sec.Read("categoriesLocked") = "1"

    favJson = sec.Read("favoriteUrls")
    if favJson <> invalid and favJson <> ""
        parsedFav = ParseJson(favJson)
        if type(parsedFav) = "roArray" then m.favoriteUrls = parsedFav
    end if

    recJson = sec.Read("recentUrls")
    if recJson <> invalid and recJson <> ""
        parsedRec = ParseJson(recJson)
        if type(parsedRec) = "roArray" then m.recentUrls = parsedRec
    end if

    lastU = sec.Read("lastWatchedUrl")
    if lastU <> invalid then m.lastWatchedUrl = lastU
    lastN = sec.Read("lastWatchedName")
    if lastN <> invalid then m.lastWatchedName = lastN
end sub

sub updateCategoryCountsLabels()
    if m.categories <> invalid
        for i = 0 to m.categories.count() - 1
            catItem = m.categories[i]
            if catItem <> invalid
                if catItem.type = "favorite" then catItem.label = "* " + auraText("favorites") + " (" + m.favoriteUrls.count().toStr() + ")"
                if catItem.type = "recent" then catItem.label = "Recientes (" + m.recentUrls.count().toStr() + ")"
                if catItem.type = "search" then catItem.label = auraText("search_all")
            end if
        end for
    end if
    if m.leftNavItems <> invalid and m.regionalState = "categories"
        for i = 0 to m.leftNavItems.count() - 1
            navItem = m.leftNavItems[i]
            if navItem <> invalid
                if navItem.type = "favorite" then navItem.label = "* " + auraText("favorites") + " (" + m.favoriteUrls.count().toStr() + ")"
                if navItem.type = "recent" then navItem.label = "Recientes (" + m.recentUrls.count().toStr() + ")"
                if navItem.type = "search" then navItem.label = auraText("search_all")
            end if
        end for
    end if
end sub

sub applyLanguageUi()
    if m.launcherTiles <> invalid
        m.launcherTiles[0].label = auraText("live_tv")
        m.launcherTiles[1].label = auraText("movies")
        m.launcherTiles[2].label = auraText("series")
        m.launcherTiles[3].label = auraText("settings")
        m.launcherTiles[4].label = auraText("playlists")
        m.launcherTiles[5].label = auraText("addons")
    end if

    if m.launcherTileNodes <> invalid
        for i = 0 to m.launcherTileNodes.count() - 1
            if m.launcherTileNodes[i] <> invalid and m.launcherTileNodes[i].label <> invalid
                lblTxt = m.launcherTiles[i].label
                if m.launcherTiles[i].layout = "bar" then lblTxt = UCase(lblTxt)
                m.launcherTileNodes[i].label.text = lblTxt
            end if
        end for
    end if

    if m.regionalTitleLabel <> invalid then m.regionalTitleLabel.text = auraText("channels")
    if m.searchTitleLabel <> invalid then m.searchTitleLabel.text = auraText("results")
    if m.playlistsTitleLabel <> invalid then m.playlistsTitleLabel.text = auraText("playlists")
    if m.addPlaylistTitleLabel <> invalid then m.addPlaylistTitleLabel.text = auraText("add_playlist")
    if m.xtreamTabLabel <> invalid then m.xtreamTabLabel.text = auraText("xtream_account")
    if m.m3uTabLabel <> invalid then m.m3uTabLabel.text = auraText("playlist")
    if m.cancelBtnLabel <> invalid then m.cancelBtnLabel.text = auraText("cancel")
    if m.okBtnLabel <> invalid then m.okBtnLabel.text = auraText("ok")
    if m.addInfoLabel1 <> invalid then m.addInfoLabel1.text = auraText("website_visit")
    if m.addInfoLabel2 <> invalid then m.addInfoLabel2.text = auraText("or_scan")
    if m.settingsTitleLabel <> invalid then m.settingsTitleLabel.text = auraText("settings")
    applyMovieLanguage()
    applyAddonsLanguage()
    if m.playlistHelpLabel1 <> invalid then m.playlistHelpLabel1.text = auraText("playlist_help_1")
    if m.playlistHelpLabel2 <> invalid then m.playlistHelpLabel2.text = auraText("playlist_help_2")
    if m.soonCloseLabel <> invalid then m.soonCloseLabel.text = auraText("close_hint")

    if m.settingsMacLabel <> invalid then m.settingsMacLabel.text = auraText("your_mac") + ": " + m.deviceMac
    if m.deviceKeyLabel <> invalid then m.deviceKeyLabel.text = auraText("your_device_key") + ": " + m.deviceKey

    if m.settingsRowNodes <> invalid
        for i = 0 to m.settingsItems.count() - 1
            if m.settingsItems[i] <> invalid
                settingKey = m.settingsItems[i].key
                settingText = auraText(settingKey)
                if settingKey = "change_language" then settingText = settingText + ": " + currentLanguageLabel()
                if m.settingsRowNodes[i] <> invalid and m.settingsRowNodes[i].label <> invalid
                    m.settingsRowNodes[i].label.text = settingText
                end if
            end if
        end for
    end if

    updateCategoryCountsLabels()
    refreshLeftNavRows()

    if m.programRows <> invalid and m.programRows.count() >= 4
        m.programRows[0].title = auraText("program_searching")
        for i = 1 to 3
            m.programRows[i].title = auraText("program_unavailable")
        end for
    end if
    if m.programNodes <> invalid
        for i = 0 to m.programNodes.count() - 1
            if i < m.programRows.count() and m.programNodes[i] <> invalid and m.programNodes[i].title <> invalid
                m.programNodes[i].title.text = m.programRows[i].title
            end if
        end for
    end if

    refreshAddPlaylistFieldText()
    updateRealTime()
    if m.languageMenuOpen = true then updateLanguageMenuUi()
end sub

sub openLanguageMenu()
    m.languageMenuOpen = true
    if m.language = "en"
        m.languageMenuIndex = 1
    else if m.language = "zh"
        m.languageMenuIndex = 2
    else
        m.languageMenuIndex = 0
    end if
    updateLanguageMenuUi()
end sub

sub closeLanguageMenu()
    m.languageMenuOpen = false
    if m.languageGroup <> invalid then m.languageGroup.visible = false
    updateAllUi()
end sub

sub updateLanguageMenuUi()
    if m.languageGroup <> invalid then m.languageGroup.visible = m.languageMenuOpen
    if m.languageMenuOpen = false then return

    if m.language = "en"
        if m.languageTitleLabel <> invalid then m.languageTitleLabel.text = "Select language"
        if m.languageHintLabel <> invalid then m.languageHintLabel.text = "OK to select · Back to cancel"
    else if m.language = "zh"
        if m.languageTitleLabel <> invalid then m.languageTitleLabel.text = "Xuanze yuyan"
        if m.languageHintLabel <> invalid then m.languageHintLabel.text = "OK xuanze · Back quxiao"
    else
        if m.languageTitleLabel <> invalid then m.languageTitleLabel.text = "Seleccionar idioma"
        if m.languageHintLabel <> invalid then m.languageHintLabel.text = "OK para seleccionar · Back para cancelar"
    end if

    languageBgs = [m.languageBg0, m.languageBg1, m.languageBg2]
    languageLabels = [m.languageLabel0, m.languageLabel1, m.languageLabel2]
    for i = 0 to 2
        if languageBgs[i] <> invalid
            if i = m.languageMenuIndex
                languageBgs[i].color = "0xFFFFFFFF"
            else
                languageBgs[i].color = "0x151E2EFF"
            end if
        end if
        if languageLabels[i] <> invalid
            if i = m.languageMenuIndex
                languageLabels[i].color = "0x090D16FF"
            else
                languageLabels[i].color = "0xFFFFFFFF"
            end if
        end if
    end for
end sub

sub selectLanguageFromMenu()
    if m.languageMenuIndex = 1
        m.language = "en"
    else if m.languageMenuIndex = 2
        m.language = "zh"
    else
        m.language = "es"
    end if

    savePrefs()
    applyLanguageUi()
    m.languageMenuOpen = false
    if m.languageGroup <> invalid then m.languageGroup.visible = false
    updateAllUi()
end sub

sub cycleLanguage()
    if m.language = "en"
        m.language = "es"
    else if m.language = "es"
        m.language = "zh"
    else
        m.language = "en"
    end if

    savePrefs()
    applyLanguageUi()
    updateAllUi()
end sub

sub setupStaticTexts()
    if m.macLabel <> invalid then m.macLabel.text = "MAC Address: " + m.deviceMac
    if m.webLabel <> invalid then m.webLabel.text = "Portal: " + m.portalBaseUrl
    if m.portalUrlLabel <> invalid then m.portalUrlLabel.text = m.portalBaseUrl
    if m.launcherVersionLabel <> invalid then m.launcherVersionLabel.text = "Device Key: " + m.deviceKey + "   ·   Version: 2.1"
    if m.playerNameLabel <> invalid then m.playerNameLabel.text = ""
    if m.playerNumberLabel <> invalid then m.playerNumberLabel.text = ""
    applyLanguageUi()
end sub
' --- CONSTRUCCIÓN DE UI ESTILO PLAYBOX OLED BLACK (#000000) ---
sub buildLauncherTiles()
    if m.launcherTilesGroup = invalid then return
    m.launcherTileNodes = []

    for each tile in m.launcherTiles
        g = m.launcherTilesGroup.createChild("Group")
        g.translation = [tile.x, tile.y]

        focusBorder = g.createChild("Rectangle")
        focusBorder.width = tile.w
        focusBorder.height = tile.h
        focusBorder.color = "0xFFFFFF22"

        bg = g.createChild("Rectangle")
        bg.translation = [2, 2]
        bg.width = tile.w - 4
        bg.height = tile.h - 4
        if tile.layout = "main"
            bg.color = "0x1A242BFF"
        else
            bg.color = "0x111820FF"
        end if

        topGlow = g.createChild("Rectangle")
        topGlow.translation = [2, 2]
        topGlow.width = tile.w - 4
        topGlow.height = Int(tile.h / 2)
        topGlow.color = "0x2C4E5A55"
        topGlow.opacity = 0.35

        topBar = g.createChild("Rectangle")
        topBar.translation = [Int(tile.w * 0.29), -4]
        topBar.width = Int(tile.w * 0.42)
        topBar.height = 6
        topBar.color = "0xFACC15FF"
        topBar.opacity = 0.0

        icon = g.createChild("Poster")
        icon.uri = tile.icon
        icon.loadDisplayMode = "scaleToFit"

        label = g.createChild("Label")
        label.text = tile.label
        label.color = "0xFFFFFFFF"

        subLabel = invalid
        metaLabel = invalid

        if tile.layout = "main"
            label.translation = [28, 28]
            label.width = 195
            label.height = 36
            label.font = "font:LargeBoldSystemFont"
            label.horizAlign = "left"

            icon.translation = [tile.w - 108, 56]
            icon.width = 80
            icon.height = 80

            subLabel = g.createChild("Label")
            subLabel.translation = [28, 122]
            subLabel.width = 195
            subLabel.height = 24
            subLabel.color = "0xFFFFFFFF"
            subLabel.font = "font:SmallBoldSystemFont"
            if tile.id = "live"
                subLabel.text = "0 Canales"
            else if tile.id = "movies"
                subLabel.text = "Catálogos VOD"
            else
                subLabel.text = "Próximamente"
            end if

            metaLabel = g.createChild("Label")
            metaLabel.translation = [28, 148]
            metaLabel.width = 195
            metaLabel.height = 18
            metaLabel.color = "0xFFFFFF9E"
            metaLabel.font = "font:SmallestSystemFont"
            if tile.id = "live"
                metaLabel.text = "Sincronización activa"
            else if tile.id = "movies"
                metaLabel.text = "Add-ons vinculados"
            else
                metaLabel.text = "En la nube"
            end if
        else
            topBar.visible = false
            icon.translation = [24, 13]
            icon.width = 20
            icon.height = 20

            label.translation = [22, 11]
            label.width = tile.w - 30
            label.height = 24
            label.font = "font:SmallBoldSystemFont"
            label.horizAlign = "center"
            label.color = "0xE2E8F0FF"
            label.text = UCase(tile.label)
        end if

        m.launcherTileNodes.push({
            group: g,
            baseX: tile.x,
            baseY: tile.y,
            layout: tile.layout,
            focusBorder: focusBorder,
            bg: bg,
            topGlow: topGlow,
            topBar: topBar,
            icon: icon,
            label: label,
            subLabel: subLabel,
            metaLabel: metaLabel
        })
    end for
end sub

sub buildLeftNav()
    if m.leftNavNodes <> invalid and m.leftNavNodes.count() > 0 then return
    if m.leftNavGroup = invalid then return

    m.leftNavNodes = []
    y = 0
    for i = 0 to 12
        row = m.leftNavGroup.createChild("Group")
        row.translation = [0, y]

        border = row.createChild("Rectangle")
        border.width = 382
        border.height = 40
        border.color = "0xFFFFFF14"

        bg = row.createChild("Rectangle")
        bg.translation = [1, 1]
        bg.width = 380
        bg.height = 38
        bg.color = "0x0D131FFF"

        logoImg = row.createChild("Poster")
        logoImg.translation = [10, 5]
        logoImg.width = 30
        logoImg.height = 30
        logoImg.loadDisplayMode = "scaleToFit"
        logoImg.visible = false

        label = row.createChild("Label")
        label.translation = [18, 7]
        label.width = 346
        label.height = 25
        label.text = ""
        label.color = "0xE2E8F0FF"
        label.font = "font:SmallBoldSystemFont"

        m.leftNavNodes.push({row: row, border: border, bg: bg, logoImg: logoImg, label: label})
        y = y + 45
    end for
end sub

sub adjustLeftNavWindow()
    if m.leftIndex < 0 then return
    if m.leftIndex < m.leftNavTop then m.leftNavTop = m.leftIndex
    lastVisible = m.leftNavTop + 12
    if m.leftIndex > lastVisible then m.leftNavTop = m.leftIndex - 12
    if m.leftNavTop < 0 then m.leftNavTop = 0
end sub

sub refreshLeftNavRows()
    if m.leftNavNodes = invalid then return
    for i = 0 to 12
        if i < m.leftNavNodes.count()
            node = m.leftNavNodes[i]
            dataIndex = m.leftNavTop + i
            if dataIndex < m.leftNavItems.count()
                if node.row <> invalid then node.row.visible = true
                item = m.leftNavItems[dataIndex]
                text = item.label

                if item.type = "channel" and item.DoesExist("channelData") and item.channelData <> invalid
                    ch = item.channelData
                    favPrefix = ""
                    if isChannelFavorite(ch.url) then favPrefix = "* "
                    numPrefix = ""
                    if ch.DoesExist("num") and ch.num <> invalid then numPrefix = ch.num.toStr() + ". "

                    st = ""
                    if m.channelStatusMap.DoesExist(ch.url) then st = m.channelStatusMap[ch.url]
                    if st = "offline"
                        text = "! " + favPrefix + numPrefix + item.label + " (No disp.)"
                    else if st = "online"
                        text = "• " + favPrefix + numPrefix + item.label
                    else
                        text = favPrefix + numPrefix + item.label
                    end if

                    if node.logoImg <> invalid
                        if ch.DoesExist("logo") and ch.logo <> invalid and ch.logo <> ""
                            node.logoImg.uri = ch.logo
                            node.logoImg.visible = true
                            node.label.translation = [48, 7]
                            node.label.width = 320
                        else
                            node.logoImg.visible = false
                            node.label.translation = [18, 7]
                            node.label.width = 346
                        end if
                    end if
                else
                    if node.logoImg <> invalid then node.logoImg.visible = false
                    node.label.translation = [18, 7]
                    node.label.width = 346
                end if

                if node.label <> invalid then node.label.text = text
            else
                if node.row <> invalid then node.row.visible = false
            end if
        end if
    end for
end sub

